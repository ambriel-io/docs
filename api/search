ine-40","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#actions","content":"Action"},"487":{"id":"/docs/ui/fraud/scoring-engine-41","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#actions","content":"Description"},"488":{"id":"/docs/ui/fraud/scoring-engine-42","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#actions","content":"Set Score"},"489":{"id":"/docs/ui/fraud/scoring-engine-43","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#actions","content":"Sets the score of the transaction to a specified value."},"490":{"id":"/docs/ui/fraud/scoring-engine-44","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#actions","content":"Set State"},"491":{"id":"/docs/ui/fraud/scoring-engine-45","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#actions","content":"Sets the state of the transaction to a specified value (Approve, Reject, Review)."},"492":{"id":"/docs/ui/fraud/scoring-engine-46","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#actions","content":"Add to List"},"493":{"id":"/docs/ui/fraud/scoring-engine-47","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#actions","content":"Adds a value to a list associated with the transaction."},"494":{"id":"/docs/ui/fraud/scoring-engine-48","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"The numeric score maps to a decision band that drives the default action. Configure the thresholds to match your risk appetite; the standard interpretation is:"},"495":{"id":"/docs/ui/fraud/scoring-engine-49","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Band"},"496":{"id":"/docs/ui/fraud/scoring-engine-50","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Score"},"497":{"id":"/docs/ui/fraud/scoring-engine-51","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Meaning"},"498":{"id":"/docs/ui/fraud/scoring-engine-52","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Default decision"},"499":{"id":"/docs/ui/fraud/scoring-engine-53","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Low risk"},"500":{"id":"/docs/ui/fraud/scoring-engine-54","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"0–29"},"501":{"id":"/docs/ui/fraud/scoring-engine-55","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Signals look clean; no risk rules fired"},"502":{"id":"/docs/ui/fraud/scoring-engine-56","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Approve"},"503":{"id":"/docs/ui/fraud/scoring-engine-57","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Medium risk"},"504":{"id":"/docs/ui/fraud/scoring-engine-58","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"30–69"},"505":{"id":"/docs/ui/fraud/scoring-engine-59","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Suspicious indicators present but not conclusive"},"506":{"id":"/docs/ui/fraud/scoring-engine-60","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Review"},"507":{"id":"/docs/ui/fraud/scoring-engine-61","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"High risk"},"508":{"id":"/docs/ui/fraud/scoring-engine-62","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"70–100"},"509":{"id":"/docs/ui/fraud/scoring-engine-63","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Strong fraud signals or a block rule matched"},"510":{"id":"/docs/ui/fraud/scoring-engine-64","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Reject"},"511":{"id":"/docs/ui/fraud/scoring-engine-65","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Bands shown in the Transactions queue use these same cutoffs, so what analysts triage matches what the engine decided. Start with the defaults, then shift boundaries after measuring false-positive and fraud-catch rates over a few weeks of live traffic."},"512":{"id":"/docs/ui/fraud/scoring-engine-66","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#how-do-rules-interact-with-scores","content":"Rules and scores work as a pair: score actions position the transaction inside a band, while state actions can pin the decision regardless of the number. A rule that sets state Reject blocks the transaction even if no score action pushed it into the high band, and a Review state routes it to the manual queue for a human call. Priority ordering decides conflicts — place narrow, high-confidence block rules above broad informational ones so the severe outcome wins."},"513":{"id":"/docs/ui/fraud/scoring-engine-67","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#how-do-rules-interact-with-scores","content":"Lists add memory across transactions: a rule can tag a device, email domain, or BIN the first time it looks suspicious, and later rules can check list membership to escalate repeat offenders. This is how single-event signals from the Digital Footprint become velocity and repeat-offender logic without custom code."},"514":{"id":"/docs/ui/fraud/scoring-engine-68","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"The following example shows a rule that sets the score to 10 if the IP address of the transaction is from the United States and the transaction amount is greater than $100:"},"515":{"id":"/docs/ui/fraud/scoring-engine-69","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Rule Name"},"516":{"id":"/docs/ui/fraud/scoring-engine-70","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Rule Type"},"517":{"id":"/docs/ui/fraud/scoring-engine-71","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Conditions"},"518":{"id":"/docs/ui/fraud/scoring-engine-72","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Action"},"519":{"id":"/docs/ui/fraud/scoring-engine-73","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"US High Amount"},"520":{"id":"/docs/ui/fraud/scoring-engine-74","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"IP Rule"},"521":{"id":"/docs/ui/fraud/scoring-engine-75","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"IP Address is from United States AND Amount > 100"},"522":{"id":"/docs/ui/fraud/scoring-engine-76","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Set Score to 10"},"523":{"id":"/docs/ui/fraud/scoring-engine-77","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"The following example shows a rule that sets the state to Review if the customer's email address is not verified and the transaction amount is greater than $50:"},"524":{"id":"/docs/ui/fraud/scoring-engine-78","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Rule Name"},"525":{"id":"/docs/ui/fraud/scoring-engine-79","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Rule Type"},"526":{"id":"/docs/ui/fraud/scoring-engine-80","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Conditions"},"527":{"id":"/docs/ui/fraud/scoring-engine-81","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Action"},"528":{"id":"/docs/ui/fraud/scoring-engine-82","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Unverified Email"},"529":{"id":"/docs/ui/fraud/scoring-engine-83","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Email Rule"},"530":{"id":"/docs/ui/fraud/scoring-engine-84","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Email Address is not verified AND Amount > 50"},"531":{"id":"/docs/ui/fraud/scoring-engine-85","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Set State to Review"},"532":{"id":"/docs/ui/fraud/scoring-engine-86","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"The following example shows a rule that sets the score to 20 if the IP address of the transaction is not from the United States and the transaction amount is greater than $100 and the customer's phone number is not verified and the email address is not verified and the BIN is not from Visa:"},"533":{"id":"/docs/ui/fraud/scoring-engine-87","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Rule Name"},"534":{"id":"/docs/ui/fraud/scoring-engine-88","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Rule Type"},"535":{"id":"/docs/ui/fraud/scoring-engine-89","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Conditions"},"536":{"id":"/docs/ui/fraud/scoring-engine-90","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Action"},"537":{"id":"/docs/ui/fraud/scoring-engine-91","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"High Amount and Unverified Information"},"538":{"id":"/docs/ui/fraud/scoring-engine-92","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"IP Rule"},"539":{"id":"/docs/ui/fraud/scoring-engine-93","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"IP Address is not from United States AND Amount > 100 AND Phone Number is not verified AND Email Address is not verified AND BIN is not Visa"},"540":{"id":"/docs/ui/fraud/scoring-engine-94","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Set Score to 20"},"541":{"id":"/docs/ui/fraud/scoring-engine-95","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#faq","content":"All matching rules fire and their trace is recorded, but priority order decides the final score and state. Put specific high-severity rules first so they override broader informational rules evaluated later."},"542":{"id":"/docs/ui/fraud/scoring-engine-96","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#faq","content":"Use score actions for graduated risk that bands can route, and state actions for hard policy — things that must always block or always review. Combining them lets the number reflect risk while the state enforces policy."},"543":{"id":"/docs/ui/fraud/scoring-engine-97","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#faq","content":"Duplicate the rule, adjust the copy, and check its matches against recent transactions before swapping it into production. Watch the review-queue volume and overturn rate afterward to confirm the change helped."},"544":{"id":"/docs/ui/fraud/transactions","page_id":"/docs/ui/fraud/transactions","type":"page","content":"Transactions","url":"/docs/ui/fraud/transactions"},"545":{"id":"/docs/ui/fraud/transactions-0","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions","content":"Track every scored transaction in Ambriel: filter by risk level, review signals and decisions, then export cases for audit trails."},"546":{"id":"/docs/ui/fraud/transactions-1","page_id":"/docs/ui/fraud/transactions","type":"heading","url":"/docs/ui/fraud/transactions#transactions","content":"Transactions"},"547":{"id":"/docs/ui/fraud/transactions-2","page_id":"/docs/ui/fraud/transactions","type":"heading","url":"/docs/ui/fraud/transactions#what-the-page-shows","content":"What the page shows"},"548":{"id":"/docs/ui/fraud/transactions-3","page_id":"/docs/ui/fraud/transactions","type":"heading","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Filtering transactions"},"549":{"id":"/docs/ui/fraud/transactions-4","page_id":"/docs/ui/fraud/transactions","type":"heading","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Risk-band meanings"},"550":{"id":"/docs/ui/fraud/transactions-5","page_id":"/docs/ui/fraud/transactions","type":"heading","url":"/docs/ui/fraud/transactions#triaging-the-review-queue","content":"Triaging the review queue"},"551":{"id":"/docs/ui/fraud/transactions-6","page_id":"/docs/ui/fraud/transactions","type":"heading","url":"/docs/ui/fraud/transactions#sort-by-score-filter-to-review","content":"Sort by score, filter to Review"},"552":{"id":"/docs/ui/fraud/transactions-7","page_id":"/docs/ui/fraud/transactions","type":"heading","url":"/docs/ui/fraud/transactions#open-the-evidence-panel","content":"Open the evidence panel"},"553":{"id":"/docs/ui/fraud/transactions-8","page_id":"/docs/ui/fraud/transactions","type":"heading","url":"/docs/ui/fraud/transactions#decide-approve-reject-or-escalate","content":"Decide: approve, reject, or escalate"},"554":{"id":"/docs/ui/fraud/transactions-9","page_id":"/docs/ui/fraud/transactions","type":"heading","url":"/docs/ui/fraud/transactions#feed-the-outcome-back-into-rules","content":"Feed the outcome back into rules"},"555":{"id":"/docs/ui/fraud/transactions-10","page_id":"/docs/ui/fraud/transactions","type":"heading","url":"/docs/ui/fraud/transactions#export-and-audit-trail","content":"Export and audit trail"},"556":{"id":"/docs/ui/fraud/transactions-11","page_id":"/docs/ui/fraud/transactions","type":"heading","url":"/docs/ui/fraud/transactions#faq","content":"FAQ"},"557":{"id":"/docs/ui/fraud/transactions-12","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#transactions","content":"The Transactions page is your operational queue for every scored payment, signup, and login: each row shows the final decision, the risk score, and the signals behind it. Use it to triage review-band traffic daily, investigate individual cases with full evidence, and export audit-ready records for compliance."},"558":{"id":"/docs/ui/fraud/transactions-13","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#what-the-page-shows","content":"Each transaction row summarizes the full output of the Scoring Engine in one line: a unique transaction ID, timestamp, customer reference, amount and currency, payment method, the final decision state (Approve, Review, or Reject), and a numeric risk score from 0 to 100. Opening a row reveals the evidence panel — which rules fired, the Digital Footprint signals attached to the session (device, IP, email, phone), and the complete decision history including manual overrides and analyst notes."},"559":{"id":"/docs/ui/fraud/transactions-14","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#what-the-page-shows","content":"type: info"},"560":{"id":"/docs/ui/fraud/transactions-15","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#what-the-page-shows","content":"Decisions shown here are final: automated rule outcomes plus any manual review actions. When a reviewer changes a state, the original score and rule trace are preserved so audits always show what the engine decided first."},"561":{"id":"/docs/ui/fraud/transactions-16","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#what-the-page-shows","content":"Scores and states update in near real time as new events stream in, so the queue always reflects the latest posture. High-risk spikes — for example a burst of transactions from one device or IP range — surface at the top when you sort by score descending, which is the recommended default view for a morning triage shift."},"562":{"id":"/docs/ui/fraud/transactions-17","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Use filters to narrow the queue to the slice you need to work. Combine several filters at once — for instance, state Review plus score above 70 plus the last 24 hours — to build a focused review list."},"563":{"id":"/docs/ui/fraud/transactions-18","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Filter"},"564":{"id":"/docs/ui/fraud/transactions-19","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Use it to"},"565":{"id":"/docs/ui/fraud/transactions-20","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Decision state (Approve / Review / Reject)"},"566":{"id":"/docs/ui/fraud/transactions-21","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Work the manual queue: start with Review, then spot-check a sample of Approve and Reject"},"567":{"id":"/docs/ui/fraud/transactions-22","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Risk score range"},"568":{"id":"/docs/ui/fraud/transactions-23","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Focus on a band, e.g. 70–100 for urgent review or 30–69 for secondary checks"},"569":{"id":"/docs/ui/fraud/transactions-24","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Date and time range"},"570":{"id":"/docs/ui/fraud/transactions-25","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Reconstruct what happened during an incident window or reconcile a settlement period"},"571":{"id":"/docs/ui/fraud/transactions-26","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Customer reference or email"},"572":{"id":"/docs/ui/fraud/transactions-27","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Pull every transaction from one buyer for a dispute or chargeback investigation"},"573":{"id":"/docs/ui/fraud/transactions-28","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Amount range"},"574":{"id":"/docs/ui/fraud/transactions-29","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Isolate high-value exposure first when review capacity is limited"},"575":{"id":"/docs/ui/fraud/transactions-30","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Payment method / BIN"},"576":{"id":"/docs/ui/fraud/transactions-31","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Chase card-testing patterns tied to one issuer or card range"},"577":{"id":"/docs/ui/fraud/transactions-32","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"IP address or country"},"578":{"id":"/docs/ui/fraud/transactions-33","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Investigate geo-mismatch clusters or traffic from sanctioned regions"},"579":{"id":"/docs/ui/fraud/transactions-34","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Device ID"},"580":{"id":"/docs/ui/fraud/transactions-35","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Find multi-accounting rings reusing the same device across identities"},"581":{"id":"/docs/ui/fraud/transactions-36","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Rule name"},"582":{"id":"/docs/ui/fraud/transactions-37","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"See everything one rule caught to tune it or measure its precision"},"583":{"id":"/docs/ui/fraud/transactions-38","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Saved views keep your most-used combinations one click away. A typical team keeps three: \"Morning review\" (Review state, score 50+, last 24h), \"High value\" (amount above threshold, any state), and \"Disputes\" (filtered by customer on demand)."},"584":{"id":"/docs/ui/fraud/transactions-39","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Scores map to decision bands that tell you how to act at a glance. Your exact thresholds are configurable in the Scoring Engine, but the default semantics are:"},"585":{"id":"/docs/ui/fraud/transactions-40","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Band"},"586":{"id":"/docs/ui/fraud/transactions-41","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Score"},"587":{"id":"/docs/ui/fraud/transactions-42","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Meaning"},"588":{"id":"/docs/ui/fraud/transactions-43","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Recommended action"},"589":{"id":"/docs/ui/fraud/transactions-44","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Low risk"},"590":{"id":"/docs/ui/fraud/transactions-45","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"0–29"},"591":{"id":"/docs/ui/fraud/transactions-46","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Signals look clean; no rule fired or only informational rules matched"},"592":{"id":"/docs/ui/fraud/transactions-47","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Auto-approve; sample periodically for QA"},"593":{"id":"/docs/ui/fraud/transactions-48","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Medium risk"},"594":{"id":"/docs/ui/fraud/transactions-49","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"30–69"},"595":{"id":"/docs/ui/fraud/transactions-50","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"One or more risk signals present but not conclusive"},"596":{"id":"/docs/ui/fraud/transactions-51","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Route to manual review or step-up authentication"},"597":{"id":"/docs/ui/fraud/transactions-52","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"High risk"},"598":{"id":"/docs/ui/fraud/transactions-53","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"70–100"},"599":{"id":"/docs/ui/fraud/transactions-54","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Strong fraud indicators or a Reject rule matched"},"600":{"id":"/docs/ui/fraud/transactions-55","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Block or hold; review before any release"},"601":{"id":"/docs/ui/fraud/transactions-56","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Bands are guidance, not verdicts: a low-score transaction with a fresh dispute still deserves a look, and a high-score transaction from a known VIP may warrant a call rather than an outright cancel."},"602":{"id":"/docs/ui/fraud/transactions-57","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#sort-by-score-filter-to-review","content":"Start each shift with decision state set to Review and sort by score descending. The riskiest cases needing a human decision sit at the top."},"603":{"id":"/docs/ui/fraud/transactions-58","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#open-the-evidence-panel","content":"Check which rules fired, the score breakdown, and the attached footprint: device reputation, IP geolocation versus billing country, email age and breach exposure, and phone carrier and line type."},"604":{"id":"/docs/ui/fraud/transactions-59","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#decide-approve-reject-or-escalate","content":"Approve genuine buyers, reject clear fraud, and escalate edge cases with a note. Every action records who decided, when, and why, so the next reviewer sees the full trail."},"605":{"id":"/docs/ui/fraud/transactions-60","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#feed-the-outcome-back-into-rules","content":"If a pattern repeats — the same BIN range, device, or email domain — take it to the Scoring Engine and tighten or add a rule so the next wave is handled automatically."},"606":{"id":"/docs/ui/fraud/transactions-61","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#export-and-audit-trail","content":"Select any set of transactions and export them to CSV for chargeback representment, internal reporting, or regulator requests. Each export includes the score, the decision state, the rules that fired, manual actions with analyst identities and timestamps, and the linked footprint evidence. Because the original automated decision is stored separately from later manual overrides, auditors can always distinguish what the engine decided from what a human changed — which is exactly what dispute and compliance reviews require."},"607":{"id":"/docs/ui/fraud/transactions-62","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#faq","content":"A Review state means a rule matched with a review action, or the score landed inside your configured review band. Open the evidence panel to see exactly which rule fired, then approve or reject manually — the decision and your note are recorded permanently."},"608":{"id":"/docs/ui/fraud/transactions-63","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#faq","content":"Yes. Reviewers with the right permissions can move a transaction between Approve, Review, and Reject. The change is appended to the decision history with who made it and when; the original engine decision is never overwritten."},"609":{"id":"/docs/ui/fraud/transactions-64","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#faq","content":"Retention follows your plan and regional settings. Transactions remain searchable and exportable for the full retention window, after which they are archived or purged according to your data policy."},"610":{"id":"/docs/ui/fraud/transactions-65","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#faq","content":"Filter by the shared attribute — device ID, IP range, email domain, or BIN — across a wide date range, then sort by score. Linked rows sharing one device or network with different identities are the classic multi-accounting pattern; export the set as a case file and tighten a rule in the scoring engine."},"611":{"id":"/docs/ui/integration/bigcommerce","page_id":"/docs/ui/integration/bigcommerce","type":"page","content":"BigCommerce","url":"/docs/ui/integration/bigcommerce"},"612":{"id":"/docs/ui/integration/bigcommerce-0","page_id":"/docs/ui/integration/bigcommerce","type":"text","url":"/docs/ui/integration/bigcommerce","content":"Connect Ambriel fraud prevention to BigCommerce: screen orders, verify buyers and block fraudulent payments with guided setup."},"613":{"id":"/docs/ui/integration/bigcommerce-1","page_id":"/docs/ui/integration/bigcommerce","type":"heading","url":"/docs/ui/integration/bigcommerce#in-progress","content":"In Progress"},"614":{"id":"/docs/ui/integration/bigcommerce-2","page_id":"/docs/ui/integration/bigcommerce","type":"text","url":"/docs/ui/integration/bigcommerce#in-progress","content":"This page is currently being worked on and will be available soon."},"615":{"id":"/docs/ui/integration","page_id":"/docs/ui/integration","type":"page","content":"Getting Started","url":"/docs/ui/integration"},"616":{"id":"/docs/ui/integration-0","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration","content":"Learn how to integrate Ambriel with your stack: REST APIs, the JavaScript agent and no-code plugins for major ecommerce platforms."},"617":{"id":"/docs/ui/integration-1","page_id":"/docs/ui/integration","type":"heading","url":"/docs/ui/integration#api-reference","content":"API Reference"},"618":{"id":"/docs/ui/integration-2","page_id":"/docs/ui/integration","type":"heading","url":"/docs/ui/integration#javascript-agent","content":"Javascript Agent"},"619":{"id":"/docs/ui/integration-3","page_id":"/docs/ui/integration","type":"heading","url":"/docs/ui/integration#e-commerce-plugins","content":"E-commerce Plugins"},"620":{"id":"/docs/ui/integration-4","page_id":"/docs/ui/integration","type":"heading","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"REST vs JS agent vs plugin — which should you choose?"},"621":{"id":"/docs/ui/integration-5","page_id":"/docs/ui/integration","type":"heading","url":"/docs/ui/integration#whats-next","content":"What's Next?"},"622":{"id":"/docs/ui/integration-6","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration","content":"Ambriel provides a range of integration options to help you get started quickly. Whether you're building a custom integration or using one of our pre-built plugins, we've got you covered."},"623":{"id":"/docs/ui/integration-7","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration","content":"By integrating Ambriel with your existing services, you can create a seamless experience for integration. You can use Ambriel as if it were your own product, without needing to map any data or use new identifiers."},"624":{"id":"/docs/ui/integration-8","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration","content":"You can use your own identifiers, such as customer_id, order_id, transaction_id, and more. This makes it easy to incorporate Ambriel into your existing workflows and processes, without having to make significant changes to your code or infrastructure."},"625":{"id":"/docs/ui/integration-9","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#api-reference","content":"If you're looking to build a custom integration, our API Reference is the perfect place to start. You'll find detailed documentation on all of our endpoints, including examples and code snippets to help you get started."},"626":{"id":"/docs/ui/integration-10","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#javascript-agent","content":"Our Javascript Agent provides a simple way to integrate Ambriel with your web application. You can use it to capture user data, track events, and trigger fraud checks."},"627":{"id":"/docs/ui/integration-11","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#e-commerce-plugins","content":"We also provide pre-built plugins for popular e-commerce platforms like Woocommerce, Wix, Shopify, and BigCommerce. These plugins make it easy to integrate Ambriel with your online store, and provide a seamless experience for your customers."},"628":{"id":"/docs/ui/integration-12","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"REST API"},"629":{"id":"/docs/ui/integration-13","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"JavaScript agent"},"630":{"id":"/docs/ui/integration-14","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"E-commerce plugin"},"631":{"id":"/docs/ui/integration-15","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"Best for"},"632":{"id":"/docs/ui/integration-16","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"Custom backends scoring orders, logins, and payouts server-side"},"633":{"id":"/docs/ui/integration-17","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"Web apps needing device fingerprinting and behavioral signals"},"634":{"id":"/docs/ui/integration-18","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"Stores on Shopify, WooCommerce, Wix, or BigCommerce"},"635":{"id":"/docs/ui/integration-19","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"Effort"},"636":{"id":"/docs/ui/integration-20","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"A few days of backend work with your own identifiers"},"637":{"id":"/docs/ui/integration-21","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"One script tag plus event calls"},"638":{"id":"/docs/ui/integration-22","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"Install and configure, no code"},"639":{"id":"/docs/ui/integration-23","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"Device intelligence"},"640":{"id":"/docs/ui/integration-24","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"Only with a session from the agent"},"641":{"id":"/docs/ui/integration-25","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"Yes, collected automatically"},"642":{"id":"/docs/ui/integration-26","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"Included where the platform allows scripts"},"643":{"id":"/docs/ui/integration-27","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"Control"},"644":{"id":"/docs/ui/integration-28","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"Full — every field, rule, and response code"},"645":{"id":"/docs/ui/integration-29","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"Client-side collection, scored server-side"},"646":{"id":"/docs/ui/integration-30","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"Fixed mapping, fastest time to value"},"647":{"id":"/docs/ui/integration-31","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"type: info"},"648":{"id":"/docs/ui/integration-32","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"title: Combine them"},"649":{"id":"/docs/ui/integration-33","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"Most setups pair the JavaScript agent (device and behavior signals) with REST scoring (server-side decisions). The plugin path already wires both together for supported platforms."},"650":{"id":"/docs/ui/integration-34","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#whats-next","content":"Once you've chosen an integration method, you can start building your Ambriel integration. If you have any questions or need help along the way, our support team is here to help."},"651":{"id":"/docs/ui/integration/js-agent","page_id":"/docs/ui/integration/js-agent","type":"page","content":"JavaScript Agent","url":"/docs/ui/integration/js-agent"},"652":{"id":"/docs/ui/integration/js-agent-0","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent","content":"Embed the Ambriel JavaScript agent in your web app: collect device intelligence and score sessions client-side with minimal code."},"653":{"id":"/docs/ui/integration/js-agent-1","page_id":"/docs/ui/integration/js-agent","type":"heading","url":"/docs/ui/integration/js-agent#how-it-works","content":"How it works"},"654":{"id":"/docs/ui/integration/js-agent-2","page_id":"/docs/ui/integration/js-agent","type":"heading","url":"/docs/ui/integration/js-agent#installation","content":"Installation"},"655":{"id":"/docs/ui/integration/js-agent-3","page_id":"/docs/ui/integration/js-agent","type":"heading","url":"/docs/ui/integration/js-agent#add-the-tracking-snippet","content":"Add the tracking snippet"},"656":{"id":"/docs/ui/integration/js-agent-4","page_id":"/docs/ui/integration/js-agent","type":"heading","url":"/docs/ui/integration/js-agent#save-the-session-id-on-your-backend","content":"Save the session ID on your backend"},"657":{"id":"/docs/ui/integration/js-agent-5","page_id":"/docs/ui/integration/js-agent","type":"heading","url":"/docs/ui/integration/js-agent#attach-the-session-id-when-scoring","content":"Attach the session ID when scoring"},"658":{"id":"/docs/ui/integration/js-agent-6","page_id":"/docs/ui/integration/js-agent","type":"heading","url":"/docs/ui/integration/js-agent#faq","content":"FAQ"},"659":{"id":"/docs/ui/integration/js-agent-7","page_id":"/docs/ui/integration/js-agent","type":"heading","url":"/docs/ui/integration/js-agent#next-steps","content":"Next steps"},"660":{"id":"/docs/ui/integration/js-agent-8","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent","content":"The JavaScript Agent collects device intelligence in the browser and links it to your server-side transactions through a session ID: the snippet below fingerprints the visitor, you persist the session ID next to your own user session, and you attach it to every /v1/transactions/ call so the scoring engine sees device and order together."},"661":{"id":"/docs/ui/integration/js-agent-9","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#how-it-works","content":"Browser — ambriel.js fingerprints the device and returns a session ID."},"662":{"id":"/docs/ui/integration/js-agent-10","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#how-it-works","content":"Your backend — you save that session ID alongside your own user session."},"663":{"id":"/docs/ui/integration/js-agent-11","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#how-it-works","content":"Checkout — you include the session ID in the transaction payload, and Ambriel scores device + order as one."},"664":{"id":"/docs/ui/integration/js-agent-12","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#how-it-works","content":"title: Keep your API key server-side"},"665":{"id":"/docs/ui/integration/js-agent-13","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#how-it-works","content":"type: warning"},"666":{"id":"/docs/ui/integration/js-agent-14","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#how-it-works","content":"The session ID is public by design (it lives in the browser). Your x-api-key, however, must never appear in frontend code — all /v1/* calls below run on your backend, with the key in an environment variable."},"667":{"id":"/docs/ui/integration/js-agent-15","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#add-the-tracking-snippet","content":"Paste this before the closing </head> tag. It loads ambriel.js asynchronously, so it never blocks your page:"},"668":{"id":"/docs/ui/integration/js-agent-16","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#save-the-session-id-on-your-backend","content":"Expose a POST /save-ambriel-session endpoint that stores the ID next to your own user session. Pick your stack once — both code blocks below follow your choice:"},"669":{"id":"/docs/ui/integration/js-agent-17","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#attach-the-session-id-when-scoring","content":"When the order completes, read the stored ID back and send it as session to POST /v1/transactions/. The tab selection follows your choice above:"},"670":{"id":"/docs/ui/integration/js-agent-18","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#attach-the-session-id-when-scoring","content":"Put the key in config/services.php under services.ambriel.key (backed by an AMBRIEL_API_KEY env var), so it never lands in version control."},"671":{"id":"/docs/ui/integration/js-agent-19","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#faq","content":"Then there is no session ID to attach — send the transaction without session. You still get rule, velocity and list screening; you only lose the device-intelligence signals for that order."},"672":{"id":"/docs/ui/integration/js-agent-20","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#faq","content":"A session covers one browsing session. Request a fresh ID on each visit (ambriel('create')); never reuse IDs across users or devices."},"673":{"id":"/docs/ui/integration/js-agent-21","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#faq","content":"Yes. Call ambriel('create') once after the snippet loads (e.g. in your app bootstrap), then read ambriel.getSession() whenever you need the ID — no page reload required."},"674":{"id":"/docs/ui/integration/shopify","page_id":"/docs/ui/integration/shopify","type":"page","content":"Shopify","url":"/docs/ui/integration/shopify"},"675":{"id":"/docs/ui/integration/shopify-0","page_id":"/docs/ui/integration/shopify","type":"text","url":"/docs/ui/integration/shopify","content":"Connect Ambriel fraud prevention to Shopify: score every checkout, screen customers and stop chargebacks with quick guided setup."},"676":{"id":"/docs/ui/integration/shopify-1","page_id":"/docs/ui/integration/shopify","type":"heading","url":"/docs/ui/integration/shopify#in-progress","content":"In Progress"},"677":{"id":"/docs/ui/integration/shopify-2","page_id":"/docs/ui/integration/shopify","type":"text","url":"/docs/ui/integration/shopify#in-progress","content":"This page is currently being worked on and will be available soon."},"678":{"id":"/docs/ui/integration/wix","page_id":"/docs/ui/integration/wix","type":"page","content":"Wix","url":"/docs/ui/integration/wix"},"679":{"id":"/docs/ui/integration/wix-0","page_id":"/docs/ui/integration/wix","type":"text","url":"/docs/ui/integration/wix","content":"Connect Ambriel fraud prevention to your Wix store: screen orders, verify customers and block risky transactions with guided setup."},"680":{"id":"/docs/ui/integration/wix-1","page_id":"/docs/ui/integration/wix","type":"heading","url":"/docs/ui/integration/wix#in-progress","content":"In Progress"},"681":{"id":"/docs/ui/integration/wix-2","page_id":"/docs/ui/integration/wix","type":"text","url":"/docs/ui/integration/wix#in-progress","content":"This page is currently being worked on and will be available soon."},"682":{"id":"/docs/ui/integration/woocommerce","page_id":"/docs/ui/integration/woocommerce","type":"page","content":"WooCommerce","url":"/docs/ui/integration/woocommerce"},"683":{"id":"/docs/ui/integration/woocommerce-0","page_id":"/docs/ui/integration/woocommerce","type":"text","url":"/docs/ui/integration/woocommerce","content":"Connect Ambriel fraud prevention to WooCommerce: score orders, verify customers and reduce chargebacks with quick guided setup."},"684":{"id":"/docs/ui/integration/woocommerce-1","page_id":"/docs/ui/integration/woocommerce","type":"heading","url":"/docs/ui/integration/woocommerce#in-progress","content":"In Progress"},"685":{"id":"/docs/ui/integration/woocommerce-2","page_id":"/docs/ui/integration/woocommerce","type":"text","url":"/docs/ui/integration/woocommerce#in-progress","content":"This page is currently being worked on and will be available soon."},"686":{"id":"/docs/ui/aml/aml-compliance","page_id":"/docs/ui/aml/aml-compliance","type":"page","content":"AML Compliance","url":"/docs/ui/aml/aml-compliance"},"687":{"id":"/docs/ui/aml/aml-compliance-0","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance","content":"Meet AML obligations with Ambriel: sanctions and PEP screening, continuous monitoring and audit-ready case management in one place."},"688":{"id":"/docs/ui/aml/aml-compliance-1","page_id":"/docs/ui/aml/aml-compliance","type":"heading","url":"/docs/ui/aml/aml-compliance#what-is-aml-compliance-and-who-needs-it","content":"What is AML compliance, and who needs it?"},"689":{"id":"/docs/ui/aml/aml-compliance-2","page_id":"/docs/ui/aml/aml-compliance","type":"heading","url":"/docs/ui/aml/aml-compliance#what-does-ambriel-screen-against","content":"What does Ambriel screen against?"},"690":{"id":"/docs/ui/aml/aml-compliance-3","page_id":"/docs/ui/aml/aml-compliance","type":"heading","url":"/docs/ui/aml/aml-compliance#how-does-real-time-screening-work","content":"How does real-time screening work?"},"691":{"id":"/docs/ui/aml/aml-compliance-4","page_id":"/docs/ui/aml/aml-compliance","type":"heading","url":"/docs/ui/aml/aml-compliance#how-does-continuous-monitoring-keep-you-covered-between-checks","content":"How does continuous monitoring keep you covered between checks?"},"692":{"id":"/docs/ui/aml/aml-compliance-5","page_id":"/docs/ui/aml/aml-compliance","type":"heading","url":"/docs/ui/aml/aml-compliance#how-does-ambriel-fit-with-the-rest-of-your-fraud-stack","content":"How does Ambriel fit with the rest of your fraud stack?"},"693":{"id":"/docs/ui/aml/aml-compliance-6","page_id":"/docs/ui/aml/aml-compliance","type":"heading","url":"/docs/ui/aml/aml-compliance#frequently-asked-questions","content":"Frequently asked questions"},"694":{"id":"/docs/ui/aml/aml-compliance-7","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#what-is-aml-compliance-and-who-needs-it","content":"Anti-Money Laundering (AML) compliance means knowing who your customers are, screening them against official watchlists, and watching for suspicious change over time. Any business that moves money or stores value — banks, fintechs, payment firms, crypto platforms, iGaming operators, marketplaces — is expected to run these checks and to prove they ran them."},"695":{"id":"/docs/ui/aml/aml-compliance-8","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#what-is-aml-compliance-and-who-needs-it","content":"Two frameworks shape almost every program. The Financial Action Task Force (FATF) sets the global standard with its recommendations on customer due diligence, sanctions screening, and Combating the Financing of Terrorism (CFT). In the European Union, the 5th and 6th Anti-Money Laundering Directives (AMLD5/6) turn those principles into hard obligations: verify customer identity, screen against sanctions and PEP lists, monitor on an ongoing basis, and keep records that auditors can inspect."},"696":{"id":"/docs/ui/aml/aml-compliance-9","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#what-is-aml-compliance-and-who-needs-it","content":"type: warning"},"697":{"id":"/docs/ui/aml/aml-compliance-10","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#what-is-aml-compliance-and-who-needs-it","content":"title: Screening is not optional under AMLD5/6"},"698":{"id":"/docs/ui/aml/aml-compliance-11","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#what-is-aml-compliance-and-who-needs-it","content":"Regulated firms must screen customers against sanctions lists and PEP databases at onboarding and re-screen them as lists change. Missing a listed person because a list updated after onboarding is still a breach."},"699":{"id":"/docs/ui/aml/aml-compliance-12","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#what-does-ambriel-screen-against","content":"Ambriel screens each entity against more than 120 sources across four list families. The table below summarizes what each family covers and why it matters for your risk decision."},"700":{"id":"/docs/ui/aml/aml-compliance-13","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#what-does-ambriel-screen-against","content":"List family"},"701":{"id":"/docs/ui/aml/aml-compliance-14","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#what-does-ambriel-screen-against","content":"What it covers"},"702":{"id":"/docs/ui/aml/aml-compliance-15","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#what-does-ambriel-screen-against","content":"Why you screen it"},"703":{"id":"/docs/ui/aml/aml-compliance-16","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#what-does-ambriel-screen-against","content":"Sanctions lists"},"704":{"id":"/docs/ui/aml/aml-compliance-17","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#what-does-ambriel-screen-against","content":"Individuals, companies, vessels, and organizations subject to economic sanctions (e.g. OFAC SDN, EU consolidated list, UN lists)"},"705":{"id":"/docs/ui/aml/aml-compliance-18","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#what-does-ambriel-screen-against","content":"Doing business with a sanctioned party can be a criminal offence and trigger asset freezes"},"706":{"id":"/docs/ui/aml/aml-compliance-19","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#what-does-ambriel-screen-against","content":"PEP lists"},"707":{"id":"/docs/ui/aml/aml-compliance-20","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#what-does-ambriel-screen-against","content":"Current and former holders of prominent public office, plus family members and close associates"},"708":{"id":"/docs/ui/aml/aml-compliance-21","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#what-does-ambriel-screen-against","content":"PEPs carry higher bribery and corruption exposure, so they need enhanced due diligence"},"709":{"id":"/docs/ui/aml/aml-compliance-22","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#what-does-ambriel-screen-against","content":"Crime lists"},"710":{"id":"/docs/ui/aml/aml-compliance-23","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#what-does-ambriel-screen-against","content":"Individuals and companies convicted of or wanted for fraud, money laundering, organized crime, and terrorism"},"711":{"id":"/docs/ui/aml/aml-compliance-24","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#what-does-ambriel-screen-against","content":"Flags counterparties with a proven or suspected criminal footprint before you onboard them"},"712":{"id":"/docs/ui/aml/aml-compliance-25","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#what-does-ambriel-screen-against","content":"Regulatory and watch lists"},"713":{"id":"/docs/ui/aml/aml-compliance-26","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#what-does-ambriel-screen-against","content":"Enforcement actions, disqualified directors, adverse-media profiles, and law-enforcement watch data"},"714":{"id":"/docs/ui/aml/aml-compliance-27","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#what-does-ambriel-screen-against","content":"Surfaces early-warning signals that do not appear on sanctions lists yet"},"715":{"id":"/docs/ui/aml/aml-compliance-28","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#what-does-ambriel-screen-against","content":"Screening runs in real time at onboarding and repeats automatically while monitoring stays switched on, so a customer who becomes listed months later still generates an alert."},"716":{"id":"/docs/ui/aml/aml-compliance-29","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#how-does-real-time-screening-work","content":"When you create an entity or call the AML screen endpoint, Ambriel normalizes the name and identifiers, searches the enabled lists, and returns scored matches instead of a blunt yes-or-no. Each hit carries a similarity score, the source list, and the matched profile, so analysts can tell a strong match from a coincidental name collision."},"717":{"id":"/docs/ui/aml/aml-compliance-30","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#how-does-real-time-screening-work","content":"Check names, companies, and counterparties against sanctions, PEP, crime, and regulatory lists in seconds, at onboarding or inside any workflow."},"718":{"id":"/docs/ui/aml/aml-compliance-31","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#how-does-real-time-screening-work","content":"Control which lists are searched and how strictly names must match in Search Configuration, balancing catch rate against false positives."},"719":{"id":"/docs/ui/aml/aml-compliance-32","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#how-does-real-time-screening-work","content":"Route scored hits into review queues, clear false positives with a reason, and escalate genuine matches into case management with a full evidence trail."},"720":{"id":"/docs/ui/aml/aml-compliance-33","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#how-does-continuous-monitoring-keep-you-covered-between-checks","content":"A one-time screen goes stale the day after it runs: lists are updated daily, PEPs leave and enter office, and clean customers can appear in enforcement actions. With monitoring enabled on an entity, Ambriel re-screens it every time the underlying lists refresh and pushes an alert when something changes — a new list appearance, a status change, or a fresh adverse-media profile."},"721":{"id":"/docs/ui/aml/aml-compliance-34","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#how-does-continuous-monitoring-keep-you-covered-between-checks","content":"Because every search and every result is written to a secure, tamper-proof log retained for 5 years, each alert arrives with its history attached: what matched, when it matched, and what the analyst did about it. That log is your audit trail when a regulator asks how a flagged customer was handled."},"722":{"id":"/docs/ui/aml/aml-compliance-35","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#how-does-ambriel-fit-with-the-rest-of-your-fraud-stack","content":"The AML API integrates seamlessly with the Fraud API, so a single customer view combines sanctions and PEP exposure with device intelligence, digital-footprint signals, and transaction risk scores. A typical wiring looks like this: score the transaction for fraud, screen the parties for AML exposure, and hold or step up anything that fails either check. Shared case management then keeps fraud and compliance decisions in one place instead of two disconnected queues."},"723":{"id":"/docs/ui/aml/aml-compliance-36","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#how-does-ambriel-fit-with-the-rest-of-your-fraud-stack","content":"type: info"},"724":{"id":"/docs/ui/aml/aml-compliance-37","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#how-does-ambriel-fit-with-the-rest-of-your-fraud-stack","content":"title: Where to go next"},"725":{"id":"/docs/ui/aml/aml-compliance-38","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#how-does-ambriel-fit-with-the-rest-of-your-fraud-stack","content":"Model the people and companies you screen in Entities, run day-to-day checks from Screening and Monitoring, and calibrate precision in Search Configuration."},"726":{"id":"/docs/ui/aml/aml-compliance-39","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#frequently-asked-questions","content":"Ambriel ingests list updates continuously and re-screens monitored entities as new data arrives — daily for fast-moving sanctions and PEP sources, on the schedule you configure for the rest. You never need to re-upload your customer base to pick up a new listing."},"727":{"id":"/docs/ui/aml/aml-compliance-40","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#frequently-asked-questions","content":"The entity generates an alert with the matched profile, source list, and score. Your team triages it in the dashboard or via the API, then clears it with a documented reason or escalates it into a case — every step lands in the 5-year audit log."},"728":{"id":"/docs/ui/aml/aml-compliance-41","page_id":"/docs/ui/aml/aml-compliance","type":"text","url":"/docs/ui/aml/aml-compliance#frequently-asked-questions","content":"No. Ambriel automates the screening, monitoring, and record-keeping, but disposition decisions — clear, escalate, exit — stay with your compliance team and your risk policy. The platform's job is to make each decision fast, consistent, and provable."},"729":{"id":"/docs/ui/aml/entities","page_id":"/docs/ui/aml/entities","type":"page","content":"Entities","url":"/docs/ui/aml/entities"},"730":{"id":"/docs/ui/aml/entities-0","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities","content":"Understand AML entities in Ambriel: how persons, companies and counterparties are modeled, screened and monitored continuously."},"731":{"id":"/docs/ui/aml/entities-1","page_id":"/docs/ui/aml/entities","type":"heading","url":"/docs/ui/aml/entities#what-are-entities-in-aml-context","content":"What are Entities in AML Context?"},"732":{"id":"/docs/ui/aml/entities-2","page_id":"/docs/ui/aml/entities","type":"heading","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"Which entity types does Ambriel screen?"},"733":{"id":"/docs/ui/aml/entities-3","page_id":"/docs/ui/aml/entities","type":"heading","url":"/docs/ui/aml/entities#politically-exposed-persons-pep","content":"Politically Exposed Persons (PEP)"},"734":{"id":"/docs/ui/aml/entities-4","page_id":"/docs/ui/aml/entities","type":"heading","url":"/docs/ui/aml/entities#sanctions-lists","content":"Sanctions Lists"},"735":{"id":"/docs/ui/aml/entities-5","page_id":"/docs/ui/aml/entities","type":"heading","url":"/docs/ui/aml/entities#crime-lists","content":"Crime Lists"},"736":{"id":"/docs/ui/aml/entities-6","page_id":"/docs/ui/aml/entities","type":"heading","url":"/docs/ui/aml/entities#watch-lists","content":"Watch Lists"},"737":{"id":"/docs/ui/aml/entities-7","page_id":"/docs/ui/aml/entities","type":"heading","url":"/docs/ui/aml/entities#why-are-entities-important-in-aml","content":"Why are Entities Important in AML?"},"738":{"id":"/docs/ui/aml/entities-8","page_id":"/docs/ui/aml/entities","type":"heading","url":"/docs/ui/aml/entities#how-can-you-use-ambriels-entities-feature","content":"How Can You Use Ambriel's Entities Feature?"},"739":{"id":"/docs/ui/aml/entities-9","page_id":"/docs/ui/aml/entities","type":"heading","url":"/docs/ui/aml/entities#how-to-create-an-entity","content":"How to create an Entity?"},"740":{"id":"/docs/ui/aml/entities-10","page_id":"/docs/ui/aml/entities","type":"heading","url":"/docs/ui/aml/entities#entity-fields","content":"Entity Fields"},"741":{"id":"/docs/ui/aml/entities-11","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#what-are-entities-in-aml-context","content":"In the context of Anti-Money Laundering (AML), entities refer to individuals, companies, or organizations that are subject to AML regulations. These entities can be either natural persons (e.g. individuals) or legal persons (e.g. companies). Ambriel's AML solution scans over 120 sources and continuously improves to provide the most accurate and up-to-date information."},"742":{"id":"/docs/ui/aml/entities-12","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"The four list families below cover different risk questions. Use the comparison table to decide which ones your policy needs enabled — most regulated firms enable all four and then tune precision in Search Configuration."},"743":{"id":"/docs/ui/aml/entities-13","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"Entity type"},"744":{"id":"/docs/ui/aml/entities-14","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"Who appears on it"},"745":{"id":"/docs/ui/aml/entities-15","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"Risk question it answers"},"746":{"id":"/docs/ui/aml/entities-16","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"Typical sources"},"747":{"id":"/docs/ui/aml/entities-17","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"Politically Exposed Persons (PEP)"},"748":{"id":"/docs/ui/aml/entities-18","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"Heads of state, ministers, MPs, judges, military leaders, state-company executives, plus family and close associates"},"749":{"id":"/docs/ui/aml/entities-19","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"Could this customer expose us to bribery or corruption proceeds?"},"750":{"id":"/docs/ui/aml/entities-20","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"Government gazettes, official PEP registers, commercial PEP databases"},"751":{"id":"/docs/ui/aml/entities-21","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"Sanctions lists"},"752":{"id":"/docs/ui/aml/entities-22","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"Individuals, companies, vessels, and organizations under economic or trade sanctions"},"753":{"id":"/docs/ui/aml/entities-23","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"Are we legally barred from doing business with this party?"},"754":{"id":"/docs/ui/aml/entities-24","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"OFAC SDN, EU consolidated list, UN Security Council lists, national sanctions regimes"},"755":{"id":"/docs/ui/aml/entities-25","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"Crime lists"},"756":{"id":"/docs/ui/aml/entities-26","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"People and companies convicted of or wanted for fraud, money laundering, organized crime, or terrorism"},"757":{"id":"/docs/ui/aml/entities-27","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"Does this counterparty have a proven or suspected criminal footprint?"},"758":{"id":"/docs/ui/aml/entities-28","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"FBI Most Wanted, Interpol Red Notices, national conviction and enforcement records"},"759":{"id":"/docs/ui/aml/entities-29","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"Watch lists"},"760":{"id":"/docs/ui/aml/entities-30","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"People and companies under surveillance or flagged in adverse media and enforcement actions"},"761":{"id":"/docs/ui/aml/entities-31","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"Is there an early-warning signal worth enhanced due diligence?"},"762":{"id":"/docs/ui/aml/entities-32","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"Law-enforcement bulletins, disqualified-director registers, adverse-media feeds"},"763":{"id":"/docs/ui/aml/entities-33","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"type: info"},"764":{"id":"/docs/ui/aml/entities-34","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"title: PEP screening includes associates"},"765":{"id":"/docs/ui/aml/entities-35","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#which-entity-types-does-ambriel-screen","content":"A PEP hit is not an accusation — it means enhanced due diligence applies. Always check the listed role, country, dates in office, and any family or associate links before deciding."},"766":{"id":"/docs/ui/aml/entities-36","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#politically-exposed-persons-pep","content":"PEPs are individuals who hold or have held prominent public offices, such as heads of state, government officials, politicians, or high-ranking military officers. PEPs are considered high-risk due to their potential exposure to corruption and bribery."},"767":{"id":"/docs/ui/aml/entities-37","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#sanctions-lists","content":"Sanctions lists are compiled by governments and international organizations to identify individuals, companies, and organizations that are subject to economic sanctions. These sanctions can be imposed due to various reasons, such as supporting terrorism, human rights violations, or nuclear proliferation."},"768":{"id":"/docs/ui/aml/entities-38","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#crime-lists","content":"Crime lists are databases of individuals and companies that have been convicted of or are suspected of committing crimes, such as fraud, money laundering, or organized crime."},"769":{"id":"/docs/ui/aml/entities-39","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#watch-lists","content":"Watch lists are databases of individuals and companies that are under surveillance by law enforcement or other authorities. These lists are used to identify and monitor potential security threats, such as terrorists, organized crime groups, or individuals with a history of fraudulent activities. Watch lists can be used to flag suspicious transactions, prevent fraud, and protect against potential security threats."},"770":{"id":"/docs/ui/aml/entities-40","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#why-are-entities-important-in-aml","content":"Entities play a crucial role in AML as they can be used to conceal illegal activities, such as money laundering and terrorist financing. Therefore, it is essential to identify and monitor entities to prevent illegal activities and ensure compliance with AML regulations."},"771":{"id":"/docs/ui/aml/entities-41","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#how-can-you-use-ambriels-entities-feature","content":"Ambriel's Entities feature allows you to screen entities against PEP, sanctions, and crime lists in real-time. You can use this feature to:"},"772":{"id":"/docs/ui/aml/entities-42","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#how-can-you-use-ambriels-entities-feature","content":"Verify the identity of customers and suppliers"},"773":{"id":"/docs/ui/aml/entities-43","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#how-can-you-use-ambriels-entities-feature","content":"Check for potential AML risks"},"774":{"id":"/docs/ui/aml/entities-44","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#how-can-you-use-ambriels-entities-feature","content":"Monitor transactions and activities"},"775":{"id":"/docs/ui/aml/entities-45","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#how-can-you-use-ambriels-entities-feature","content":"Comply with AML regulations"},"776":{"id":"/docs/ui/aml/entities-46","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#how-can-you-use-ambriels-entities-feature","content":"Once entities exist, keep them under continuous screening and monitoring so list updates surface as alerts instead of silent exposure."},"777":{"id":"/docs/ui/aml/entities-47","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#how-to-create-an-entity","content":"Login to dashboard"},"778":{"id":"/docs/ui/aml/entities-48","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#how-to-create-an-entity","content":"Go to Aml > Entities"},"779":{"id":"/docs/ui/aml/entities-49","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#how-to-create-an-entity","content":"Click on \"Create Entity\""},"780":{"id":"/docs/ui/aml/entities-50","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#how-to-create-an-entity","content":"Check out  example."},"781":{"id":"/docs/ui/aml/entities-51","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"The following table shows the fields that are required to create an entity."},"782":{"id":"/docs/ui/aml/entities-52","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"Field Name"},"783":{"id":"/docs/ui/aml/entities-53","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"Description"},"784":{"id":"/docs/ui/aml/entities-54","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"Required"},"785":{"id":"/docs/ui/aml/entities-55","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"entityId"},"786":{"id":"/docs/ui/aml/entities-56","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"Unique identifier for the entity"},"787":{"id":"/docs/ui/aml/entities-57","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"schema"},"788":{"id":"/docs/ui/aml/entities-58","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"The schema of the entity"},"789":{"id":"/docs/ui/aml/entities-59","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"name"},"790":{"id":"/docs/ui/aml/entities-60","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"The name of the entity"},"791":{"id":"/docs/ui/aml/entities-61","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"phone"},"792":{"id":"/docs/ui/aml/entities-62","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"Phone number of the entity"},"793":{"id":"/docs/ui/aml/entities-63","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"address"},"794":{"id":"/docs/ui/aml/entities-64","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"Address of the entity"},"795":{"id":"/docs/ui/aml/entities-65","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"email"},"796":{"id":"/docs/ui/aml/entities-66","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"Email address of the entity"},"797":{"id":"/docs/ui/aml/entities-67","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"country"},"798":{"id":"/docs/ui/aml/entities-68","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"Country of the entity"},"799":{"id":"/docs/ui/aml/entities-69","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"state"},"800":{"id":"/docs/ui/aml/entities-70","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"State of the entity (if natural person)"},"801":{"id":"/docs/ui/aml/entities-71","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"city"},"802":{"id":"/docs/ui/aml/entities-72","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"City of the entity"},"803":{"id":"/docs/ui/aml/entities-73","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"dob"},"804":{"id":"/docs/ui/aml/entities-74","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"Date of birth of the entity"},"805":{"id":"/docs/ui/aml/entities-75","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"monitor"},"806":{"id":"/docs/ui/aml/entities-76","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"Monitor the entity for AML risks"},"807":{"id":"/docs/ui/aml/screening-monitoring","page_id":"/docs/ui/aml/screening-monitoring","type":"page","content":"Screening and Monitoring","url":"/docs/ui/aml/screening-monitoring"},"808":{"id":"/docs/ui/aml/screening-monitoring-0","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring","content":"Protect your business from financial crime: screen entities against sanctions and PEP lists, then monitor them continuously for change."},"809":{"id":"/docs/ui/aml/screening-monitoring-1","page_id":"/docs/ui/aml/screening-monitoring","type":"heading","url":"/docs/ui/aml/screening-monitoring#why-monitor-entities-instead-of-screening-once","content":"Why monitor entities instead of screening once?"},"810":{"id":"/docs/ui/aml/screening-monitoring-2","page_id":"/docs/ui/aml/screening-monitoring","type":"heading","url":"/docs/ui/aml/screening-monitoring#what-are-entities-in-aml-context","content":"What are entities in AML context?"},"811":{"id":"/docs/ui/aml/screening-monitoring-3","page_id":"/docs/ui/aml/screening-monitoring","type":"heading","url":"/docs/ui/aml/screening-monitoring#how-can-you-use-ambriels-screening-and-monitoring","content":"How can you use Ambriel's screening and monitoring?"},"812":{"id":"/docs/ui/aml/screening-monitoring-4","page_id":"/docs/ui/aml/screening-monitoring","type":"heading","url":"/docs/ui/aml/screening-monitoring#how-do-you-triage-a-monitoring-alert","content":"How do you triage a monitoring alert?"},"813":{"id":"/docs/ui/aml/screening-monitoring-5","page_id":"/docs/ui/aml/screening-monitoring","type":"heading","url":"/docs/ui/aml/screening-monitoring#read-the-match-before-reacting","content":"Read the match before reacting"},"814":{"id":"/docs/ui/aml/screening-monitoring-6","page_id":"/docs/ui/aml/screening-monitoring","type":"heading","url":"/docs/ui/aml/screening-monitoring#compare-identifiers-not-just-names","content":"Compare identifiers, not just names"},"815":{"id":"/docs/ui/aml/screening-monitoring-7","page_id":"/docs/ui/aml/screening-monitoring","type":"heading","url":"/docs/ui/aml/screening-monitoring#check-the-list-source-and-its-freshness","content":"Check the list source and its freshness"},"816":{"id":"/docs/ui/aml/screening-monitoring-8","page_id":"/docs/ui/aml/screening-monitoring","type":"heading","url":"/docs/ui/aml/screening-monitoring#decide-clear-watch-or-escalate","content":"Decide: clear, watch, or escalate"},"817":{"id":"/docs/ui/aml/screening-monitoring-9","page_id":"/docs/ui/aml/screening-monitoring","type":"heading","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"Document the decision"},"818":{"id":"/docs/ui/aml/screening-monitoring-10","page_id":"/docs/ui/aml/screening-monitoring","type":"heading","url":"/docs/ui/aml/screening-monitoring#how-do-you-switch-monitoring-on","content":"How do you switch monitoring on?"},"819":{"id":"/docs/ui/aml/screening-monitoring-11","page_id":"/docs/ui/aml/screening-monitoring","type":"heading","url":"/docs/ui/aml/screening-monitoring#frequently-asked-questions","content":"Frequently asked questions"},"820":{"id":"/docs/ui/aml/screening-monitoring-12","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#why-monitor-entities-instead-of-screening-once","content":"Entities play a crucial role in Anti-Money Laundering (AML) regulations. A one-time screen only proves a customer was clean on that day — sanctions designations, PEP appointments, convictions, and adverse-media stories all land after onboarding. Monitoring entities continuously closes that gap: every list refresh re-checks your portfolio, so a customer who becomes risky months later surfaces as an alert instead of a surprise finding in an audit."},"821":{"id":"/docs/ui/aml/screening-monitoring-13","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#why-monitor-entities-instead-of-screening-once","content":"Monitoring also proves diligence over time. Each re-screen and each analyst decision is written to the tamper-proof log, giving regulators a complete story from onboarding to the latest check."},"822":{"id":"/docs/ui/aml/screening-monitoring-14","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#what-are-entities-in-aml-context","content":"Entities refer to individuals, companies, or organizations that are subject to AML regulations. These entities can be either natural persons (e.g. individuals) or legal persons (e.g. companies). Before you can monitor anything, model each customer, supplier, or counterparty as an entity with enough identifiers — name plus date of birth, country, or address — to separate true matches from name collisions."},"823":{"id":"/docs/ui/aml/screening-monitoring-15","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-can-you-use-ambriels-screening-and-monitoring","content":"Ambriel's Entities feature allows you to screen entities against PEP, sanctions, and crime lists in real-time. You can use this feature to:"},"824":{"id":"/docs/ui/aml/screening-monitoring-16","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-can-you-use-ambriels-screening-and-monitoring","content":"Verify the identity of customers and suppliers"},"825":{"id":"/docs/ui/aml/screening-monitoring-17","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-can-you-use-ambriels-screening-and-monitoring","content":"Check for potential AML risks"},"826":{"id":"/docs/ui/aml/screening-monitoring-18","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-can-you-use-ambriels-screening-and-monitoring","content":"Monitor transactions and activities"},"827":{"id":"/docs/ui/aml/screening-monitoring-19","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-can-you-use-ambriels-screening-and-monitoring","content":"Comply with AML regulations"},"828":{"id":"/docs/ui/aml/screening-monitoring-20","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-can-you-use-ambriels-screening-and-monitoring","content":"Catch sanctioned parties, PEPs, and known criminals before funds move — not after."},"829":{"id":"/docs/ui/aml/screening-monitoring-21","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-can-you-use-ambriels-screening-and-monitoring","content":"Re-screen the whole portfolio on every list refresh and keep a 5-year audit trail without manual work."},"830":{"id":"/docs/ui/aml/screening-monitoring-22","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-can-you-use-ambriels-screening-and-monitoring","content":"Scored matches with source profiles let analysts clear false positives in minutes and escalate real hits with evidence attached."},"831":{"id":"/docs/ui/aml/screening-monitoring-23","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-do-you-triage-a-monitoring-alert","content":"Every alert deserves the same disciplined pass before it is cleared or escalated. Follow these steps for each hit:"},"832":{"id":"/docs/ui/aml/screening-monitoring-24","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#read-the-match-before-reacting","content":"Open the alert and note the score, the source list, and the listed profile. A 0.95 sanctions match on full name plus date of birth is a different situation from a 0.55 PEP match on surname alone."},"833":{"id":"/docs/ui/aml/screening-monitoring-25","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#compare-identifiers-not-just-names","content":"Check date of birth, nationality, addresses, and company registration details against your customer record. If two or more independent identifiers agree, treat it as a likely true match; if only a common name agrees, lean toward a false positive."},"834":{"id":"/docs/ui/aml/screening-monitoring-26","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#check-the-list-source-and-its-freshness","content":"Confirm which list produced the hit and when it was updated. Sanctions designations demand immediate action, while an old adverse-media item may only warrant enhanced due diligence at next review."},"835":{"id":"/docs/ui/aml/screening-monitoring-27","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#decide-clear-watch-or-escalate","content":"Clear false positives with a written reason, keep ambiguous cases under monitoring with a review date, and escalate likely true matches into case management — freezing activity where your policy requires it."},"836":{"id":"/docs/ui/aml/screening-monitoring-28","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"Record who decided, what evidence they used, and what happens next. The log entry is what your auditor reads, so write it for someone who was not in the room."},"837":{"id":"/docs/ui/aml/screening-monitoring-29","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"Use the disposition table below to keep decisions consistent across analysts:"},"838":{"id":"/docs/ui/aml/screening-monitoring-30","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"Disposition"},"839":{"id":"/docs/ui/aml/screening-monitoring-31","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"When to use it"},"840":{"id":"/docs/ui/aml/screening-monitoring-32","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"What to record"},"841":{"id":"/docs/ui/aml/screening-monitoring-33","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"True match — escalate"},"842":{"id":"/docs/ui/aml/screening-monitoring-34","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"Two or more identifiers agree, or any sanctions-list agreement"},"843":{"id":"/docs/ui/aml/screening-monitoring-35","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"Matched profile, evidence, freeze or exit action, SAR consideration"},"844":{"id":"/docs/ui/aml/screening-monitoring-36","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"Possible match — enhanced review"},"845":{"id":"/docs/ui/aml/screening-monitoring-37","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"Partial agreement or credible adverse media"},"846":{"id":"/docs/ui/aml/screening-monitoring-38","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"Extra identifiers requested, review date, risk-owner sign-off"},"847":{"id":"/docs/ui/aml/screening-monitoring-39","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"False positive — clear"},"848":{"id":"/docs/ui/aml/screening-monitoring-40","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"Identifiers clearly disagree (wrong country, age, company)"},"849":{"id":"/docs/ui/aml/screening-monitoring-41","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"Mismatch reason, so the same alert can be auto-cleared next refresh"},"850":{"id":"/docs/ui/aml/screening-monitoring-42","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"type: warning"},"851":{"id":"/docs/ui/aml/screening-monitoring-43","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"title: Never clear a sanctions hit on name alone"},"852":{"id":"/docs/ui/aml/screening-monitoring-44","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"If any sanctions-list identifiers plausibly agree, escalate rather than clear. Clearing a true sanctions match can itself be a regulatory breach — when in doubt, freeze and escalate."},"853":{"id":"/docs/ui/aml/screening-monitoring-45","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-do-you-switch-monitoring-on","content":"Login to dashboard"},"854":{"id":"/docs/ui/aml/screening-monitoring-46","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-do-you-switch-monitoring-on","content":"Go to Aml > Entities"},"855":{"id":"/docs/ui/aml/screening-monitoring-47","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-do-you-switch-monitoring-on","content":"Find the entity you want to monitor"},"856":{"id":"/docs/ui/aml/screening-monitoring-48","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-do-you-switch-monitoring-on","content":"Enable Monitoring switch"},"857":{"id":"/docs/ui/aml/screening-monitoring-49","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-do-you-switch-monitoring-on","content":"Monitoring uses the lists and match strictness from your Search Configuration. If alerts feel noisy, tighten the score threshold or typo tolerance there rather than switching monitoring off."},"858":{"id":"/docs/ui/aml/screening-monitoring-50","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#frequently-asked-questions","content":"Any meaningful change for a monitored entity: a new appearance on an enabled list, a status change on an existing listing, or a fresh profile that now scores above your threshold. Routine list refreshes with no new matches stay silent."},"859":{"id":"/docs/ui/aml/screening-monitoring-51","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#frequently-asked-questions","content":"Treat PEP status as a due-diligence flag, not a verdict. Apply enhanced checks — source of funds, beneficial ownership, senior approval — and record the rationale. Only escalate to a case if you find corroborating criminal, sanctions, or adverse-media exposure."},"860":{"id":"/docs/ui/aml/screening-monitoring-52","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#frequently-asked-questions","content":"All searches and results are stored in the secure, tamper-proof log for 5 years, including every alert, disposition, and analyst note — ready for regulator or auditor review."},"861":{"id":"/docs/ui/aml/search-configuration","page_id":"/docs/ui/aml/search-configuration","type":"page","content":"Search Configuration","url":"/docs/ui/aml/search-configuration"},"862":{"id":"/docs/ui/aml/search-configuration-0","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration","content":"Configure sanctions-list search in Ambriel: fuzzy-match thresholds, watchlist selection and entity tuning for precise, quiet hits."},"863":{"id":"/docs/ui/aml/search-configuration-1","page_id":"/docs/ui/aml/search-configuration","type":"heading","url":"/docs/ui/aml/search-configuration#what-is-search-configuration","content":"What is Search Configuration?"},"864":{"id":"/docs/ui/aml/search-configuration-2","page_id":"/docs/ui/aml/search-configuration","type":"heading","url":"/docs/ui/aml/search-configuration#what-are-the-configurations","content":"What are the Configurations?"},"865":{"id":"/docs/ui/aml/search-configuration-3","page_id":"/docs/ui/aml/search-configuration","type":"heading","url":"/docs/ui/aml/search-configuration#frequency","content":"Frequency"},"866":{"id":"/docs/ui/aml/search-configuration-4","page_id":"/docs/ui/aml/search-configuration","type":"heading","url":"