tity"},"1090":{"id":"/docs/ui/aml/entities-61","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"phone"},"1091":{"id":"/docs/ui/aml/entities-62","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"Phone number of the entity"},"1092":{"id":"/docs/ui/aml/entities-63","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"address"},"1093":{"id":"/docs/ui/aml/entities-64","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"Address of the entity"},"1094":{"id":"/docs/ui/aml/entities-65","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"email"},"1095":{"id":"/docs/ui/aml/entities-66","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"Email address of the entity"},"1096":{"id":"/docs/ui/aml/entities-67","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"country"},"1097":{"id":"/docs/ui/aml/entities-68","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"Country of the entity"},"1098":{"id":"/docs/ui/aml/entities-69","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"state"},"1099":{"id":"/docs/ui/aml/entities-70","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"State of the entity (if natural person)"},"1100":{"id":"/docs/ui/aml/entities-71","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"city"},"1101":{"id":"/docs/ui/aml/entities-72","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"City of the entity"},"1102":{"id":"/docs/ui/aml/entities-73","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"dob"},"1103":{"id":"/docs/ui/aml/entities-74","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"Date of birth of the entity"},"1104":{"id":"/docs/ui/aml/entities-75","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"monitor"},"1105":{"id":"/docs/ui/aml/entities-76","page_id":"/docs/ui/aml/entities","type":"text","url":"/docs/ui/aml/entities#entity-fields","content":"Monitor the entity for AML risks"},"1106":{"id":"/docs/ui/aml/screening-monitoring","page_id":"/docs/ui/aml/screening-monitoring","type":"page","content":"Screening and Monitoring","url":"/docs/ui/aml/screening-monitoring"},"1107":{"id":"/docs/ui/aml/screening-monitoring-0","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring","content":"Protect your business from financial crime: screen entities against sanctions and PEP lists, then monitor them continuously for change."},"1108":{"id":"/docs/ui/aml/screening-monitoring-1","page_id":"/docs/ui/aml/screening-monitoring","type":"heading","url":"/docs/ui/aml/screening-monitoring#why-monitor-entities-instead-of-screening-once","content":"Why monitor entities instead of screening once?"},"1109":{"id":"/docs/ui/aml/screening-monitoring-2","page_id":"/docs/ui/aml/screening-monitoring","type":"heading","url":"/docs/ui/aml/screening-monitoring#what-are-entities-in-aml-context","content":"What are entities in AML context?"},"1110":{"id":"/docs/ui/aml/screening-monitoring-3","page_id":"/docs/ui/aml/screening-monitoring","type":"heading","url":"/docs/ui/aml/screening-monitoring#how-can-you-use-ambriels-screening-and-monitoring","content":"How can you use Ambriel's screening and monitoring?"},"1111":{"id":"/docs/ui/aml/screening-monitoring-4","page_id":"/docs/ui/aml/screening-monitoring","type":"heading","url":"/docs/ui/aml/screening-monitoring#how-do-you-triage-a-monitoring-alert","content":"How do you triage a monitoring alert?"},"1112":{"id":"/docs/ui/aml/screening-monitoring-5","page_id":"/docs/ui/aml/screening-monitoring","type":"heading","url":"/docs/ui/aml/screening-monitoring#read-the-match-before-reacting","content":"Read the match before reacting"},"1113":{"id":"/docs/ui/aml/screening-monitoring-6","page_id":"/docs/ui/aml/screening-monitoring","type":"heading","url":"/docs/ui/aml/screening-monitoring#compare-identifiers-not-just-names","content":"Compare identifiers, not just names"},"1114":{"id":"/docs/ui/aml/screening-monitoring-7","page_id":"/docs/ui/aml/screening-monitoring","type":"heading","url":"/docs/ui/aml/screening-monitoring#check-the-list-source-and-its-freshness","content":"Check the list source and its freshness"},"1115":{"id":"/docs/ui/aml/screening-monitoring-8","page_id":"/docs/ui/aml/screening-monitoring","type":"heading","url":"/docs/ui/aml/screening-monitoring#decide-clear-watch-or-escalate","content":"Decide: clear, watch, or escalate"},"1116":{"id":"/docs/ui/aml/screening-monitoring-9","page_id":"/docs/ui/aml/screening-monitoring","type":"heading","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"Document the decision"},"1117":{"id":"/docs/ui/aml/screening-monitoring-10","page_id":"/docs/ui/aml/screening-monitoring","type":"heading","url":"/docs/ui/aml/screening-monitoring#how-do-you-switch-monitoring-on","content":"How do you switch monitoring on?"},"1118":{"id":"/docs/ui/aml/screening-monitoring-11","page_id":"/docs/ui/aml/screening-monitoring","type":"heading","url":"/docs/ui/aml/screening-monitoring#frequently-asked-questions","content":"Frequently asked questions"},"1119":{"id":"/docs/ui/aml/screening-monitoring-12","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#why-monitor-entities-instead-of-screening-once","content":"Entities play a crucial role in Anti-Money Laundering (AML) regulations. A one-time screen only proves a customer was clean on that day — sanctions designations, PEP appointments, convictions, and adverse-media stories all land after onboarding. Monitoring entities continuously closes that gap: every list refresh re-checks your portfolio, so a customer who becomes risky months later surfaces as an alert instead of a surprise finding in an audit."},"1120":{"id":"/docs/ui/aml/screening-monitoring-13","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#why-monitor-entities-instead-of-screening-once","content":"Monitoring also proves diligence over time. Each re-screen and each analyst decision is written to the tamper-proof log, giving regulators a complete story from onboarding to the latest check."},"1121":{"id":"/docs/ui/aml/screening-monitoring-14","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#what-are-entities-in-aml-context","content":"Entities refer to individuals, companies, or organizations that are subject to AML regulations. These entities can be either natural persons (e.g. individuals) or legal persons (e.g. companies). Before you can monitor anything, model each customer, supplier, or counterparty as an entity with enough identifiers — name plus date of birth, country, or address — to separate true matches from name collisions."},"1122":{"id":"/docs/ui/aml/screening-monitoring-15","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-can-you-use-ambriels-screening-and-monitoring","content":"Ambriel's Entities feature allows you to screen entities against PEP, sanctions, and crime lists in real-time. You can use this feature to:"},"1123":{"id":"/docs/ui/aml/screening-monitoring-16","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-can-you-use-ambriels-screening-and-monitoring","content":"Verify the identity of customers and suppliers"},"1124":{"id":"/docs/ui/aml/screening-monitoring-17","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-can-you-use-ambriels-screening-and-monitoring","content":"Check for potential AML risks"},"1125":{"id":"/docs/ui/aml/screening-monitoring-18","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-can-you-use-ambriels-screening-and-monitoring","content":"Monitor transactions and activities"},"1126":{"id":"/docs/ui/aml/screening-monitoring-19","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-can-you-use-ambriels-screening-and-monitoring","content":"Comply with AML regulations"},"1127":{"id":"/docs/ui/aml/screening-monitoring-20","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-can-you-use-ambriels-screening-and-monitoring","content":"Catch sanctioned parties, PEPs, and known criminals before funds move — not after."},"1128":{"id":"/docs/ui/aml/screening-monitoring-21","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-can-you-use-ambriels-screening-and-monitoring","content":"Re-screen the whole portfolio on every list refresh and keep a 5-year audit trail without manual work."},"1129":{"id":"/docs/ui/aml/screening-monitoring-22","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-can-you-use-ambriels-screening-and-monitoring","content":"Scored matches with source profiles let analysts clear false positives in minutes and escalate real hits with evidence attached."},"1130":{"id":"/docs/ui/aml/screening-monitoring-23","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-do-you-triage-a-monitoring-alert","content":"Every alert deserves the same disciplined pass before it is cleared or escalated. Follow these steps for each hit:"},"1131":{"id":"/docs/ui/aml/screening-monitoring-24","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#read-the-match-before-reacting","content":"Open the alert and note the score, the source list, and the listed profile. A 0.95 sanctions match on full name plus date of birth is a different situation from a 0.55 PEP match on surname alone."},"1132":{"id":"/docs/ui/aml/screening-monitoring-25","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#compare-identifiers-not-just-names","content":"Check date of birth, nationality, addresses, and company registration details against your customer record. If two or more independent identifiers agree, treat it as a likely true match; if only a common name agrees, lean toward a false positive."},"1133":{"id":"/docs/ui/aml/screening-monitoring-26","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#check-the-list-source-and-its-freshness","content":"Confirm which list produced the hit and when it was updated. Sanctions designations demand immediate action, while an old adverse-media item may only warrant enhanced due diligence at next review."},"1134":{"id":"/docs/ui/aml/screening-monitoring-27","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#decide-clear-watch-or-escalate","content":"Clear false positives with a written reason, keep ambiguous cases under monitoring with a review date, and escalate likely true matches into case management — freezing activity where your policy requires it."},"1135":{"id":"/docs/ui/aml/screening-monitoring-28","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"Record who decided, what evidence they used, and what happens next. The log entry is what your auditor reads, so write it for someone who was not in the room."},"1136":{"id":"/docs/ui/aml/screening-monitoring-29","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"Use the disposition table below to keep decisions consistent across analysts:"},"1137":{"id":"/docs/ui/aml/screening-monitoring-30","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"Disposition"},"1138":{"id":"/docs/ui/aml/screening-monitoring-31","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"When to use it"},"1139":{"id":"/docs/ui/aml/screening-monitoring-32","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"What to record"},"1140":{"id":"/docs/ui/aml/screening-monitoring-33","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"True match — escalate"},"1141":{"id":"/docs/ui/aml/screening-monitoring-34","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"Two or more identifiers agree, or any sanctions-list agreement"},"1142":{"id":"/docs/ui/aml/screening-monitoring-35","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"Matched profile, evidence, freeze or exit action, SAR consideration"},"1143":{"id":"/docs/ui/aml/screening-monitoring-36","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"Possible match — enhanced review"},"1144":{"id":"/docs/ui/aml/screening-monitoring-37","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"Partial agreement or credible adverse media"},"1145":{"id":"/docs/ui/aml/screening-monitoring-38","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"Extra identifiers requested, review date, risk-owner sign-off"},"1146":{"id":"/docs/ui/aml/screening-monitoring-39","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"False positive — clear"},"1147":{"id":"/docs/ui/aml/screening-monitoring-40","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"Identifiers clearly disagree (wrong country, age, company)"},"1148":{"id":"/docs/ui/aml/screening-monitoring-41","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"Mismatch reason, so the same alert can be auto-cleared next refresh"},"1149":{"id":"/docs/ui/aml/screening-monitoring-42","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"type: warning"},"1150":{"id":"/docs/ui/aml/screening-monitoring-43","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"title: Never clear a sanctions hit on name alone"},"1151":{"id":"/docs/ui/aml/screening-monitoring-44","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#document-the-decision","content":"If any sanctions-list identifiers plausibly agree, escalate rather than clear. Clearing a true sanctions match can itself be a regulatory breach — when in doubt, freeze and escalate."},"1152":{"id":"/docs/ui/aml/screening-monitoring-45","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-do-you-switch-monitoring-on","content":"Login to dashboard"},"1153":{"id":"/docs/ui/aml/screening-monitoring-46","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-do-you-switch-monitoring-on","content":"Go to Aml > Entities"},"1154":{"id":"/docs/ui/aml/screening-monitoring-47","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-do-you-switch-monitoring-on","content":"Find the entity you want to monitor"},"1155":{"id":"/docs/ui/aml/screening-monitoring-48","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-do-you-switch-monitoring-on","content":"Enable Monitoring switch"},"1156":{"id":"/docs/ui/aml/screening-monitoring-49","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#how-do-you-switch-monitoring-on","content":"Monitoring uses the lists and match strictness from your Search Configuration. If alerts feel noisy, tighten the score threshold or typo tolerance there rather than switching monitoring off."},"1157":{"id":"/docs/ui/aml/screening-monitoring-50","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#frequently-asked-questions","content":"Any meaningful change for a monitored entity: a new appearance on an enabled list, a status change on an existing listing, or a fresh profile that now scores above your threshold. Routine list refreshes with no new matches stay silent."},"1158":{"id":"/docs/ui/aml/screening-monitoring-51","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#frequently-asked-questions","content":"Treat PEP status as a due-diligence flag, not a verdict. Apply enhanced checks — source of funds, beneficial ownership, senior approval — and record the rationale. Only escalate to a case if you find corroborating criminal, sanctions, or adverse-media exposure."},"1159":{"id":"/docs/ui/aml/screening-monitoring-52","page_id":"/docs/ui/aml/screening-monitoring","type":"text","url":"/docs/ui/aml/screening-monitoring#frequently-asked-questions","content":"All searches and results are stored in the secure, tamper-proof log for 5 years, including every alert, disposition, and analyst note — ready for regulator or auditor review."},"1160":{"id":"/docs/ui/aml/search-configuration","page_id":"/docs/ui/aml/search-configuration","type":"page","content":"Search Configuration","url":"/docs/ui/aml/search-configuration"},"1161":{"id":"/docs/ui/aml/search-configuration-0","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration","content":"Configure sanctions-list search in Ambriel: fuzzy-match thresholds, watchlist selection and entity tuning for precise, quiet hits."},"1162":{"id":"/docs/ui/aml/search-configuration-1","page_id":"/docs/ui/aml/search-configuration","type":"heading","url":"/docs/ui/aml/search-configuration#what-is-search-configuration","content":"What is Search Configuration?"},"1163":{"id":"/docs/ui/aml/search-configuration-2","page_id":"/docs/ui/aml/search-configuration","type":"heading","url":"/docs/ui/aml/search-configuration#what-are-the-configurations","content":"What are the Configurations?"},"1164":{"id":"/docs/ui/aml/search-configuration-3","page_id":"/docs/ui/aml/search-configuration","type":"heading","url":"/docs/ui/aml/search-configuration#frequency","content":"Frequency"},"1165":{"id":"/docs/ui/aml/search-configuration-4","page_id":"/docs/ui/aml/search-configuration","type":"heading","url":"/docs/ui/aml/search-configuration#enable-sanctions","content":"Enable Sanctions"},"1166":{"id":"/docs/ui/aml/search-configuration-5","page_id":"/docs/ui/aml/search-configuration","type":"heading","url":"/docs/ui/aml/search-configuration#enable-pep","content":"Enable PEP"},"1167":{"id":"/docs/ui/aml/search-configuration-6","page_id":"/docs/ui/aml/search-configuration","type":"heading","url":"/docs/ui/aml/search-configuration#enable-crime","content":"Enable Crime"},"1168":{"id":"/docs/ui/aml/search-configuration-7","page_id":"/docs/ui/aml/search-configuration","type":"heading","url":"/docs/ui/aml/search-configuration#enable-regulatory","content":"Enable Regulatory"},"1169":{"id":"/docs/ui/aml/search-configuration-8","page_id":"/docs/ui/aml/search-configuration","type":"heading","url":"/docs/ui/aml/search-configuration#search-type","content":"Search Type"},"1170":{"id":"/docs/ui/aml/search-configuration-9","page_id":"/docs/ui/aml/search-configuration","type":"heading","url":"/docs/ui/aml/search-configuration#score-threshold","content":"Score Threshold"},"1171":{"id":"/docs/ui/aml/search-configuration-10","page_id":"/docs/ui/aml/search-configuration","type":"heading","url":"/docs/ui/aml/search-configuration#fuzzy-search-settings","content":"Fuzzy Search Settings"},"1172":{"id":"/docs/ui/aml/search-configuration-11","page_id":"/docs/ui/aml/search-configuration","type":"heading","url":"/docs/ui/aml/search-configuration#edit-distance-thresholds","content":"Edit Distance Thresholds"},"1173":{"id":"/docs/ui/aml/search-configuration-12","page_id":"/docs/ui/aml/search-configuration","type":"heading","url":"/docs/ui/aml/search-configuration#edit-distance-threshold-for-two-typos","content":"Edit distance threshold for two typos"},"1174":{"id":"/docs/ui/aml/search-configuration-13","page_id":"/docs/ui/aml/search-configuration","type":"heading","url":"/docs/ui/aml/search-configuration#num-typos","content":"Num Typos"},"1175":{"id":"/docs/ui/aml/search-configuration-14","page_id":"/docs/ui/aml/search-configuration","type":"heading","url":"/docs/ui/aml/search-configuration#drop-tokens-threshold","content":"Drop Tokens Threshold"},"1176":{"id":"/docs/ui/aml/search-configuration-15","page_id":"/docs/ui/aml/search-configuration","type":"heading","url":"/docs/ui/aml/search-configuration#typo-tokens-threshold","content":"Typo Tokens Threshold"},"1177":{"id":"/docs/ui/aml/search-configuration-16","page_id":"/docs/ui/aml/search-configuration","type":"heading","url":"/docs/ui/aml/search-configuration#use-case-recommendations","content":"Use Case Recommendations"},"1178":{"id":"/docs/ui/aml/search-configuration-17","page_id":"/docs/ui/aml/search-configuration","type":"heading","url":"/docs/ui/aml/search-configuration#remarks","content":"Remarks"},"1179":{"id":"/docs/ui/aml/search-configuration-18","page_id":"/docs/ui/aml/search-configuration","type":"heading","url":"/docs/ui/aml/search-configuration#how-to-configure-search-settings","content":"How to Configure Search Settings?"},"1180":{"id":"/docs/ui/aml/search-configuration-19","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration","content":"Search Configuration controls which lists Ambriel searches and how strictly names must match. Lower score thresholds and typo tolerance catch more variants but raise false positives, while higher thresholds stay precise. Start with defaults, enable only the lists your policy requires, then tighten thresholds until alerts stay actionable."},"1181":{"id":"/docs/ui/aml/search-configuration-20","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#what-is-search-configuration","content":"Search Configuration is a feature in Ambriel's AML solution that allows you to customize how sanctions lists are searched. You can configure the search settings to better suit your business needs."},"1182":{"id":"/docs/ui/aml/search-configuration-21","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#what-are-the-configurations","content":"The following are the configurations you can make:"},"1183":{"id":"/docs/ui/aml/search-configuration-22","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#frequency","content":"The frequency determines how often the sanctions list is updated. The options are:"},"1184":{"id":"/docs/ui/aml/search-configuration-23","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#frequency","content":"Daily"},"1185":{"id":"/docs/ui/aml/search-configuration-24","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#frequency","content":"Weekly"},"1186":{"id":"/docs/ui/aml/search-configuration-25","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#frequency","content":"Bi-Weekly"},"1187":{"id":"/docs/ui/aml/search-configuration-26","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#frequency","content":"Quarterly"},"1188":{"id":"/docs/ui/aml/search-configuration-27","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#frequency","content":"Monthly"},"1189":{"id":"/docs/ui/aml/search-configuration-28","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#frequency","content":"Yearly"},"1190":{"id":"/docs/ui/aml/search-configuration-29","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#enable-sanctions","content":"Enable sanctions determines whether the sanctions list is enabled or not. If enabled, the sanctions list will be searched when you search for an entity."},"1191":{"id":"/docs/ui/aml/search-configuration-30","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#enable-pep","content":"Enable PEP determines whether the PEP list is enabled or not. If enabled, the PEP list will be searched when you search for an entity."},"1192":{"id":"/docs/ui/aml/search-configuration-31","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#enable-crime","content":"Enable crime determines whether the crime list is enabled or not. If enabled, the crime list will be searched when you search for an entity."},"1193":{"id":"/docs/ui/aml/search-configuration-32","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#enable-regulatory","content":"Enable regulatory determines whether the regulatory list is enabled or not. If enabled, the regulatory list will be searched when you search for an entity."},"1194":{"id":"/docs/ui/aml/search-configuration-33","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#search-type","content":"The search type determines how the search is performed. The options are:"},"1195":{"id":"/docs/ui/aml/search-configuration-34","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#search-type","content":"Exact"},"1196":{"id":"/docs/ui/aml/search-configuration-35","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#search-type","content":"Fuzzy"},"1197":{"id":"/docs/ui/aml/search-configuration-36","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#score-threshold","content":"The score_threshold determines the minimum similarity score required for a document to be considered a match. The score ranges from 0.0 (no similarity) to 1.0 (perfect match). Only results with a score equal to or above the specified threshold are returned."},"1198":{"id":"/docs/ui/aml/search-configuration-37","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#score-threshold","content":"Score Threshold"},"1199":{"id":"/docs/ui/aml/search-configuration-38","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#score-threshold","content":"Search Query"},"1200":{"id":"/docs/ui/aml