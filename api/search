/agents/claude","type":"text","url":"/docs/ui/agents/claude#available-tools","content":"AML screening — Screen entities against sanctions, PEP, and watchlists"},"187":{"id":"/docs/ui/agents/claude-48","page_id":"/docs/ui/agents/claude","type":"text","url":"/docs/ui/agents/claude#available-tools","content":"Email/Phone/IP checks — Validate and enrich contact data"},"188":{"id":"/docs/ui/agents/claude-49","page_id":"/docs/ui/agents/claude","type":"text","url":"/docs/ui/agents/claude#available-tools","content":"KYB evaluations — Evaluate company risk profiles"},"189":{"id":"/docs/ui/agents/claude-50","page_id":"/docs/ui/agents/claude","type":"text","url":"/docs/ui/agents/claude#available-tools","content":"BIN lookups — Get card details from BIN numbers"},"190":{"id":"/docs/ui/agents/claude-51","page_id":"/docs/ui/agents/claude","type":"text","url":"/docs/ui/agents/claude#example","content":"Here's how it looks in action:"},"191":{"id":"/docs/ui/agents/claude-52","page_id":"/docs/ui/agents/claude","type":"text","url":"/docs/ui/agents/claude#example","content":"Ask Claude to format output for your workflow — a decline rationale, a SAR-ready summary, or a comparison table. Because the data comes from live tools, you can paste the result straight into a case file."},"192":{"id":"/docs/ui/agents/claude-53","page_id":"/docs/ui/agents/claude","type":"text","url":"/docs/ui/agents/claude#faq","content":"Look for the hammer icon and per-tool call badges in the transcript. If Claude answers without a tool call, rephrase with trigger words like \"screen,\" \"score,\" or \"look up.\""},"193":{"id":"/docs/ui/agents/claude-54","page_id":"/docs/ui/agents/claude","type":"text","url":"/docs/ui/agents/claude#faq","content":"Use https://mcp.ambriel.io/compliance for production compliance workloads. It carries fraud, AML, KYB, and all lookup tools behind OAuth."},"194":{"id":"/docs/ui/agents/claude-55","page_id":"/docs/ui/agents/claude","type":"text","url":"/docs/ui/agents/claude#faq","content":"This usually means a stale Ambriel session or a blocked popup. Sign in to Ambriel in your main browser first, allow popups for Claude, then click Connect again."},"195":{"id":"/docs/ui/agents/claude-56","page_id":"/docs/ui/agents/claude","type":"text","url":"/docs/ui/agents/claude#faq","content":"Yes — the same URL works with any MCP-capable Claude client, via OAuth or a service token."},"196":{"id":"/docs/ui/agents/cursor","page_id":"/docs/ui/agents/cursor","type":"page","content":"Cursor","url":"/docs/ui/agents/cursor"},"197":{"id":"/docs/ui/agents/cursor-0","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor","content":"Integrate Ambriel into Cursor IDE via MCP: call fraud, AML and KYB tools directly from your editor while building risk features."},"198":{"id":"/docs/ui/agents/cursor-1","page_id":"/docs/ui/agents/cursor","type":"heading","url":"/docs/ui/agents/cursor#cursor","content":"Cursor"},"199":{"id":"/docs/ui/agents/cursor-2","page_id":"/docs/ui/agents/cursor","type":"heading","url":"/docs/ui/agents/cursor#setup","content":"Setup"},"200":{"id":"/docs/ui/agents/cursor-3","page_id":"/docs/ui/agents/cursor","type":"heading","url":"/docs/ui/agents/cursor#which-tools-are-exposed","content":"Which tools are exposed?"},"201":{"id":"/docs/ui/agents/cursor-4","page_id":"/docs/ui/agents/cursor","type":"heading","url":"/docs/ui/agents/cursor#example","content":"Example"},"202":{"id":"/docs/ui/agents/cursor-5","page_id":"/docs/ui/agents/cursor","type":"heading","url":"/docs/ui/agents/cursor#faq","content":"FAQ"},"203":{"id":"/docs/ui/agents/cursor-6","page_id":"/docs/ui/agents/cursor","type":"heading","url":"/docs/ui/agents/cursor#next-steps","content":"Next steps"},"204":{"id":"/docs/ui/agents/cursor-7","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#cursor","content":"You can integrate Ambriel into Cursor IDE via MCP in minutes using OAuth, with no API keys to manage. Once enabled, Cursor's AI can call fraud scoring, AML screening, KYB evaluation, and email, phone, IP, and BIN lookups directly from your editor while you build and review risk features."},"205":{"id":"/docs/ui/agents/cursor-8","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#cursor","content":"title: Prerequisites"},"206":{"id":"/docs/ui/agents/cursor-9","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#cursor","content":"You need a recent Cursor version with MCP Servers under Features, plus an Ambriel account with compliance API access. A browser is required for the one-time OAuth approval — after that the token persists across restarts."},"207":{"id":"/docs/ui/agents/cursor-10","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#cursor","content":"The Cursor integration shines during implementation: validate a signup form against real risk data, generate fixtures from live lookups, or ask the agent to wire a screening step into onboarding. Tools run in context, so Cursor sees your code and the response together."},"208":{"id":"/docs/ui/agents/cursor-11","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#setup","content":"Go to Cursor Settings → Features → MCP Servers."},"209":{"id":"/docs/ui/agents/cursor-12","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#setup","content":"Click Add New MCP Server and enter:"},"210":{"id":"/docs/ui/agents/cursor-13","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#setup","content":"Name: ambriel"},"211":{"id":"/docs/ui/agents/cursor-14","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#setup","content":"Type: url"},"212":{"id":"/docs/ui/agents/cursor-15","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#setup","content":"URL: https://mcp.ambriel.io/compliance"},"213":{"id":"/docs/ui/agents/cursor-16","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#setup","content":"Prefer JSON config? Paste this into your mcp.json:"},"214":{"id":"/docs/ui/agents/cursor-17","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#setup","content":"Save and confirm the server shows a green connected status."},"215":{"id":"/docs/ui/agents/cursor-18","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#setup","content":"After adding the server, Cursor will prompt you to authorize the connection. A browser window will open — log in with your Ambriel credentials and approve the access request."},"216":{"id":"/docs/ui/agents/cursor-19","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#setup","content":"Return to Cursor and verify the Ambriel tools appear in the MCP tool list. If the browser flow stalls, copy the redirect URL into your default browser manually."},"217":{"id":"/docs/ui/agents/cursor-20","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#setup","content":"The Ambriel tools are now available to Cursor's AI. Try asking:"},"218":{"id":"/docs/ui/agents/cursor-21","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#setup","content":"\"Check if this email is risky\""},"219":{"id":"/docs/ui/agents/cursor-22","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#setup","content":"\"Screen this company for PEP status\""},"220":{"id":"/docs/ui/agents/cursor-23","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#setup","content":"\"Look up this phone number\""},"221":{"id":"/docs/ui/agents/cursor-24","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#setup","content":"In Agent mode, try a code-aware prompt: \"Add an AML screen to this signup handler and test it with a sanctioned name.\" Cursor will call Ambriel, show the result, and propose the diff."},"222":{"id":"/docs/ui/agents/cursor-25","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#setup","content":"Cursor's AI will automatically use the MCP tools when relevant to your code. For example, if you're reviewing a user registration flow, it can check the email and phone in real time."},"223":{"id":"/docs/ui/agents/cursor-26","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#which-tools-are-exposed","content":"Cursor's agent picks tools from intent, but you can also name them explicitly in prompts for deterministic behavior."},"224":{"id":"/docs/ui/agents/cursor-27","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#which-tools-are-exposed","content":"Tool"},"225":{"id":"/docs/ui/agents/cursor-28","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#which-tools-are-exposed","content":"What it does"},"226":{"id":"/docs/ui/agents/cursor-29","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#which-tools-are-exposed","content":"fraud-score"},"227":{"id":"/docs/ui/agents/cursor-30","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#which-tools-are-exposed","content":"Scores transactions and onboarding attempts inline"},"228":{"id":"/docs/ui/agents/cursor-31","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#which-tools-are-exposed","content":"aml-screen"},"229":{"id":"/docs/ui/agents/cursor-32","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#which-tools-are-exposed","content":"Screens names and companies against sanctions and PEP lists"},"230":{"id":"/docs/ui/agents/cursor-33","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#which-tools-are-exposed","content":"email-lookup"},"231":{"id":"/docs/ui/agents/cursor-34","page_id":"/docs/ui/agents/cursor","type":"text","url":"/docs/ui/agents/cursor#which-tools-are-exposed","content":"Flags di