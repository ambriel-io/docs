re."},"1568":{"id":"/docs/ui/products/phone-number-intelligence-11","page_id":"/docs/ui/products/phone-number-intelligence","type":"text","url":"/docs/ui/products/phone-number-intelligence#what-does-the-api-return","content":"A POST /v1/phone lookup returns validation, line, carrier, and risk fields. The table below covers the ones to build rules on."},"1569":{"id":"/docs/ui/products/phone-number-intelligence-12","page_id":"/docs/ui/products/phone-number-intelligence","type":"text","url":"/docs/ui/products/phone-number-intelligence#what-does-the-api-return","content":"Field"},"1570":{"id":"/docs/ui/products/phone-number-intelligence-13","page_id":"/docs/ui/products/phone-number-intelligence","type":"text","url":"/docs/ui/products/phone-number-intelligence#what-does-the-api-return","content":"What it tells you"},"1571":{"id":"/docs/ui/products/phone-number-intelligence-14","page_id":"/docs/ui/products/phone-number-intelligence","type":"text","url":"/docs/ui/products/phone-number-intelligence#what-does-the-api-return","content":"How to use it"},"1572":{"id":"/docs/ui/products/phone-number-intelligence-15","page_id":"/docs/ui/products/phone-number-intelligence","type":"text","url":"/docs/ui/products/phone-number-intelligence#what-does-the-api-return","content":"phone"},"1573":{"id":"/docs/ui/products/phone-number-intelligence-16","page_id":"/docs/ui/products/phone-number-intelligence","type":"text","url":"/docs/ui/products/phone-number-intelligence#what-does-the-api-return","content":"Normalized number that was assessed"},"1574":{"id":"/docs/ui/products/phone-number-intelligence-17","page_id":"/docs/ui/products/phone-number-intelligence","type":"text","url":"/docs/ui/products/phone-number-intelligence#what-does-the-api-return","content":"Echo it into your case notes and logs"},"1575":{"id":"/docs/ui/products/phone-number-intelligence-18","page_id":"/docs/ui/products/phone-number-intelligence","type":"text","url":"/docs/ui/products/phone-number-intelligence#what-does-th