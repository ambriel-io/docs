t","url":"/docs/ui/aml/search-configuration#what-are-the-configurations","content":"The following are the configurations you can make:"},"884":{"id":"/docs/ui/aml/search-configuration-22","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#frequency","content":"The frequency determines how often the sanctions list is updated. The options are:"},"885":{"id":"/docs/ui/aml/search-configuration-23","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#frequency","content":"Daily"},"886":{"id":"/docs/ui/aml/search-configuration-24","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#frequency","content":"Weekly"},"887":{"id":"/docs/ui/aml/search-configuration-25","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#frequency","content":"Bi-Weekly"},"888":{"id":"/docs/ui/aml/search-configuration-26","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#frequency","content":"Quarterly"},"889":{"id":"/docs/ui/aml/search-configuration-27","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#frequency","content":"Monthly"},"890":{"id":"/docs/ui/aml/search-configuration-28","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#frequency","content":"Yearly"},"891":{"id":"/docs/ui/aml/search-configuration-29","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#enable-sanctions","content":"Enable sanctions determines whether the sanctions list is enabled or not. If enabled, the sanctions list will be searched when you search for an entity."},"892":{"id":"/docs/ui/aml/search-configuration-30","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#enable-pep",