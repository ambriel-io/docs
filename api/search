","content":"3"},"738":{"id":"/docs/ui/aml/search-configuration-227","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#typo-tokens-threshold","content":"All tokens can have typos (loosest match)"},"739":{"id":"/docs/ui/aml/search-configuration-228","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#use-case-recommendations","content":"Use Case"},"740":{"id":"/docs/ui/aml/search-configuration-229","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#use-case-recommendations","content":"typo_tokens_threshold Value"},"741":{"id":"/docs/ui/aml/search-configuration-230","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#use-case-recommendations","content":"Strict exact-ish match"},"742":{"id":"/docs/ui/aml/search-configuration-231","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#use-case-recommendations","content":"1"},"743":{"id":"/docs/ui/aml/search-configuration-232","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#use-case-recommendations","content":"Allow for common noise words (is, the, a)"},"744":{"id":"/docs/ui/aml/search-configuration-233","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#use-case-recommendations","content":"2"},"745":{"id":"/docs/ui/aml/search-configuration-234","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#use-case-recommendations","content":"Loose fuzzy matching (name search)"},"746":{"id":"/docs/ui/aml/search-configuration-235","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#use-case-recommendations","content":"3"},"747":{"id":"/docs/ui/aml/search-configuration-236","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#remarks","content":"Loose fuzzy matching (name search) and less score threshold is not recommended. It can lead to unexpected/false-positive results.\nBe careful with this setting and use it with caution. Remember to always double-check the search results."},"748":{"id":"/docs/ui/aml/search-configuration-237","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#how-to-configure-search-settings","content":"Login to your Ambriel dashboard."},"749":{"id":"/docs/ui/aml/search-configuration-238","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#how-to-configure-search-settings","content":"Go to the Settings menu and select AML Configuration"},"750":{"id":"/docs/ui/aml/search-configuration-239","page_id":"/docs/ui/aml/search-configuration","type":"text","url":"/docs/ui/aml/search-configuration#how-to-configure-search-settings","content":"Configure the search settings as desired."},"751":{"id":"/docs/ui/fraud/digital-footprint","page_id":"/docs/ui/fraud/digital-footprint","type":"page","content":"Digital Footprint","url":"/docs/ui/fraud/digital-footprint"},"752":{"id":"/docs/ui/fraud/digital-footprint-0","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint","content":"See how Ambriel tracks devices, behavior and location signals to catch fake accounts and fraud before checkout completes."},"753":{"id":"/docs/ui/fraud/digital-footprint-1","page_id":"/docs/ui/fraud/digital-footprint","type":"heading","url":"/docs/ui/fraud/digital-footprint#what-is-digital-footprint","content":"What is Digital Footprint?"},"754":{"id":"/docs/ui/fraud/digital-footprint-2","page_id":"/docs/ui/fraud/digital-footprint","type":"heading","url":"/docs/ui/fraud/digital-footprint#signal-categories","content":"Signal categories"},"755":{"id":"/docs/ui/fraud/digital-footprint-3","page_id":"/docs/ui/fraud/digital-footprint","type":"heading","url":"/docs/ui/fraud/digital-footprint#device-identification","content":"Device identification"},"756":{"id":"/docs/ui/fraud/digital-footprint-4","page_id":"/docs/ui/fraud/digital-footprint","type":"heading","url":"/docs/ui/fraud/digital-footprint#device-safety-and-security-checks","content":"Device safety and security checks"},"757":{"id":"/docs/ui/fraud/digital-footprint-5","page_id":"/docs/ui/fraud/digital-footprint","type":"heading","url":"/docs/ui/fraud/digital-footprint#email-phone-and-ip-reputation","content":"Email, phone, and IP reputation"},"758":{"id":"/docs/ui/fraud/digital-footprint-6","page_id":"/docs/ui/fraud/digital-footprint","type":"heading","url":"/docs/ui/fraud/digital-footprint#real-time-location-tracking","content":"Real-time location tracking"},"759":{"id":"/docs/ui/fraud/digital-footprint-7","page_id":"/docs/ui/fraud/digital-footprint","type":"heading","url":"/docs/ui/fraud/digital-footprint#network-and-connection-monitoring","content":"Network and connection monitoring"},"760":{"id":"/docs/ui/fraud/digital-footprint-8","page_id":"/docs/ui/fraud/digital-footprint","type":"heading","url":"/docs/ui/fraud/digital-footprint#analyzing-software-hardware-environment-and-screen-data","content":"Analyzing software, hardware environment, and screen data"},"761":{"id":"/docs/ui/fraud/digital-footprint-9","page_id":"/docs/ui/fraud/digital-footprint","type":"heading","url":"/docs/ui/fraud/digital-footprint#behavioral-and-environmental-analysis","content":"Behavioral and environmental analysis"},"762":{"id":"/docs/ui/fraud/digital-footprint-10","page_id":"/docs/ui/fraud/digital-footprint","type":"heading","url":"/docs/ui/fraud/digital-footprint#geofencing-for-location-based-regulation-compliance-igaming","content":"Geofencing for location-based regulation compliance (iGaming)"},"763":{"id":"/docs/ui/fraud/digital-footprint-11","page_id":"/docs/ui/fraud/digital-footprint","type":"heading","url":"/docs/ui/fraud/digital-footprint#how-is-the-fingerprint-collected","content":"How is the fingerprint collected?"},"764":{"id":"/docs/ui/fraud/digital-footprint-12","page_id":"/docs/ui/fraud/digital-footprint","type":"heading","url":"/docs/ui/fraud/digital-footprint#using-footprint-data-in-decisions","content":"Using footprint data in decisions"},"765":{"id":"/docs/ui/fraud/digital-footprint-13","page_id":"/docs/ui/fraud/digital-footprint","type":"heading","url":"/docs/ui/fraud/digital-footprint#faq","content":"FAQ"},"766":{"id":"/docs/ui/fraud/digital-footprint-14","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#what-is-digital-footprint","content":"Digital footprint is the trail of data users leave when interacting with your product — device attributes, network details, location consistency, contact-data history, and behavior patterns. Ambriel's digital footprint capabilities turn that trail into fraud evidence by revealing patterns of online behavior, identifying suspicious activity, and verifying the authenticity of user profiles before money moves."},"767":{"id":"/docs/ui/fraud/digital-footprint-15","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#what-is-digital-footprint","content":"In short: Ambriel links the device, network, contact details, and behavior of every session into one identity picture, so fakes stand out even when the name on the account looks legitimate. The signals feed the Scoring Engine and appear as evidence on each row of the Transactions queue."},"768":{"id":"/docs/ui/fraud/digital-footprint-16","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#what-is-digital-footprint","content":"type: info"},"769":{"id":"/docs/ui/fraud/digital-footprint-17","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#what-is-digital-footprint","content":"Footprint signals are enrichment, not verdicts. One red flag rarely decides a transaction — combine signals in scoring rules so genuine users on odd networks are not blocked by a single anomaly."},"770":{"id":"/docs/ui/fraud/digital-footprint-18","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#signal-categories","content":"Signal"},"771":{"id":"/docs/ui/fraud/digital-footprint-19","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#signal-categories","content":"What it catches"},"772":{"id":"/docs/ui/fraud/digital-footprint-20","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#signal-categories","content":"Device identification"},"773":{"id":"/docs/ui/fraud/digital-footprint-21","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#signal-categories","content":"Multi-accounting rings and returning banned users by linking sessions across identities on the same hardware"},"774":{"id":"/docs/ui/fraud/digital-footprint-22","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#signal-categories","content":"Device safety and security checks"},"775":{"id":"/docs/ui/fraud/digital-footprint-23","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#signal-categories","content":"Rooted or jailbroken phones, emulators, and tampered environments used to spoof legitimate devices"},"776":{"id":"/docs/ui/fraud/digital-footprint-24","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#signal-categories","content":"Email reputation and breach exposure"},"777":{"id":"/docs/ui/fraud/digital-footprint-25","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#signal-categories","content":"Fake and disposable addresses, plus credentials already leaked in breaches and reused by account-takeover crews"},"778":{"id":"/docs/ui/fraud/digital-footprint-26","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#signal-categories","content":"Phone carrier and line-type intelligence"},"779":{"id":"/docs/ui/fraud/digital-footprint-27","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#signal-categories","content":"VoIP burners, invalid ranges, and recently ported numbers typical of one-time abuse accounts"},"780":{"id":"/docs/ui/fraud/digital-footprint-28","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#signal-categories","content":"IP reputation and network analysis"},"781":{"id":"/docs/ui/fraud/digital-footprint-29","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#signal-categories","content":"Anonymous proxies, VPN exit nodes, Tor, hosting ranges, and botnets masking the attacker's true origin"},"782":{"id":"/docs/ui/fraud/digital-footprint-30","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#signal-categories","content":"Real-time location tracking"},"783":{"id":"/docs/ui/fraud/digital-footprint-31","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#signal-categories","content":"Impossible travel, billing-country mismatch, and geolocation spoofing at checkout or login"},"784":{"id":"/docs/ui/fraud/digital-footprint-32","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#signal-categories","content":"Software, hardware, and screen analysis"},"785":{"id":"/docs/ui/fraud/digital-footprint-33","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#signal-categories","content":"Headless browsers, mismatched screen and OS fingerprints, and automation frameworks pretending to be human"},"786":{"id":"/docs/ui/fraud/digital-footprint-34","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#signal-categories","content":"Behavioral and environmental analysis"},"787":{"id":"/docs/ui/fraud/digital-footprint-35","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#signal-categories","content":"Bot-speed form fills, copy-paste credential stuffing, and interaction patterns no human repeats at scale"},"788":{"id":"/docs/ui/fraud/digital-footprint-36","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#signal-categories","content":"Geofencing for regulated markets"},"789":{"id":"/docs/ui/fraud/digital-footprint-37","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#signal-categories","content":"Out-of-jurisdiction play and GPS manipulation for iGaming compliance and location-gated promotions"},"790":{"id":"/docs/ui/fraud/digital-footprint-38","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#device-identification","content":"Track unique devices across web and mobile platforms, linking activity across multiple sessions. When five \"different\" customers share one fingerprint, you are looking at one operator, not five buyers."},"791":{"id":"/docs/ui/fraud/digital-footprint-39","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#device-safety-and-security-checks","content":"Verify the security status of a device before allowing access to your platform. This ensures that your users are legitimate and not using compromised devices such as rooted phones or emulated environments."},"792":{"id":"/docs/ui/fraud/digital-footprint-40","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#email-phone-and-ip-reputation","content":"These three contact-and-network signals validate the identity anchors of an account. Disposable emails, fresh domains with no history, VoIP numbers with no tenure, and datacenter IPs each add risk weight — and together they reliably separate throwaway fraud accounts from established genuine users."},"793":{"id":"/docs/ui/fraud/digital-footprint-41","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#real-time-location-tracking","content":"Track the real-time location of users, allowing you to ensure that their geolocation matches expected behavior. This is essential for spotting suspicious access attempts or potential fraud such as logins from two countries minutes apart."},"794":{"id":"/docs/ui/fraud/digital-footprint-42","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#network-and-connection-monitoring","content":"Monitor the user's network and connection details to identify suspicious activity and prevent fraud, from ASN reputation to proxy and tunnel detection."},"795":{"id":"/docs/ui/fraud/digital-footprint-43","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#analyzing-software-hardware-environment-and-screen-data","content":"Verify the authenticity of devices and detect potential tampering or manipulation by analyzing the software, hardware, and screen data of each user device — the inconsistencies automation leaves behind."},"796":{"id":"/docs/ui/fraud/digital-footprint-44","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#behavioral-and-environmental-analysis","content":"Monitor user behavior in real time and flag deviations that could indicate fraudulent or automated activities, such as inhuman input speed or perfectly repeated interaction sequences."},"797":{"id":"/docs/ui/fraud/digital-footprint-45","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#geofencing-for-location-based-regulation-compliance-igaming","content":"Integrate with real-time location tracking to validate that transactions align with local regulations, ensuring compliance while blocking suspicious attempts to manipulate location data."},"798":{"id":"/docs/ui/fraud/digital-footprint-46","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#how-is-the-fingerprint-collected","content":"Collection starts with the lightweight JavaScript agent embedded on your pages — it captures device attributes, browser and screen characteristics, and behavioral telemetry during the session and attaches them to the scoring request. Follow the JS agent setup guide to install the snippet, verify events are flowing, and confirm fingerprints appear on test transactions."},"799":{"id":"/docs/ui/fraud/digital-footprint-47","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#how-is-the-fingerprint-collected","content":"Native mobile SDKs provide the equivalent telemetry for iOS and Android, while server-side lookup APIs enrich email, phone, and IP fields that never touch the frontend. All three paths converge: the agent and SDKs supply what only the client can observe, the lookups add historical reputation, and the Fraud API merges everything into one footprint per transaction."},"800":{"id":"/docs/ui/fraud/digital-footprint-48","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#how-is-the-fingerprint-collected","content":"type: warning"},"801":{"id":"/docs/ui/fraud/digital-footprint-49","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#how-is-the-fingerprint-collected","content":"Load the agent on every page where risk matters — signup, login, and checkout — not just the payment step. Fraudsters probe early; a fingerprint captured at account creation links the later fraudulent purchase back to the same device."},"802":{"id":"/docs/ui/fraud/digital-footprint-50","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#using-footprint-data-in-decisions","content":"Reference footprint fields directly in scoring rules: block datacenter IPs on high-value orders, route disposable-email signups to review, or step up authentication when device and billing country diverge. Each row in the Transactions queue shows the footprint behind its score, so reviewers see the same evidence the rules used."},"803":{"id":"/docs/ui/fraud/digital-footprint-51","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#faq","content":"In most regions, device and behavior collection counts as processing that needs disclosure and often consent. Publish it in your privacy policy, wire the agent to your consent manager, and confirm the legal basis with counsel before launch."},"804":{"id":"/docs/ui/fraud/digital-footprint-52","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#faq","content":"You still get a decision. The footprint is thinner — fewer device and behavior attributes — so rules should treat missing telemetry as a mild risk factor rather than an automatic block, and lean on server-side email, phone, and IP lookups."},"805":{"id":"/docs/ui/fraud/digital-footprint-53","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#faq","content":"Sophisticated attackers can rotate some attributes, but rarely all of them at once across device, network, behavior, and contact history. Layered signals plus velocity tracking make large-scale evasion expensive, which is what stops most operations."},"806":{"id":"/docs/ui/fraud/digital-footprint-54","page_id":"/docs/ui/fraud/digital-footprint","type":"text","url":"/docs/ui/fraud/digital-footprint#faq","content":"Install the agent in staging per the setup guide, run a test signup and checkout, then open the matching rows in the review queue and confirm device, IP, and behavior evidence is attached before promoting to production."},"807":{"id":"/docs/ui/fraud/fraud-prevention","page_id":"/docs/ui/fraud/fraud-prevention","type":"page","content":"Fraud Prevention","url":"/docs/ui/fraud/fraud-prevention"},"808":{"id":"/docs/ui/fraud/fraud-prevention-0","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention","content":"Stop fraud before it costs you: real-time scoring, device intelligence and rule automation for transactions across every industry."},"809":{"id":"/docs/ui/fraud/fraud-prevention-1","page_id":"/docs/ui/fraud/fraud-prevention","type":"heading","url":"/docs/ui/fraud/fraud-prevention#fraud-scoring-api","content":"Fraud scoring API"},"810":{"id":"/docs/ui/fraud/fraud-prevention-2","page_id":"/docs/ui/fraud/fraud-prevention","type":"heading","url":"/docs/ui/fraud/fraud-prevention#digital-footprint","content":"Digital footprint"},"811":{"id":"/docs/ui/fraud/fraud-prevention-3","page_id":"/docs/ui/fraud/fraud-prevention","type":"heading","url":"/docs/ui/fraud/fraud-prevention#device-intelligence","content":"Device intelligence"},"812":{"id":"/docs/ui/fraud/fraud-prevention-4","page_id":"/docs/ui/fraud/fraud-prevention","type":"heading","url":"/docs/ui/fraud/fraud-prevention#scoring-engine-and-rules","content":"Scoring engine and rules"},"813":{"id":"/docs/ui/fraud/fraud-prevention-5","page_id":"/docs/ui/fraud/fraud-prevention","type":"heading","url":"/docs/ui/fraud/fraud-prevention#transaction-review-queue","content":"Transaction review queue"},"814":{"id":"/docs/ui/fraud/fraud-prevention-6","page_id":"/docs/ui/fraud/fraud-prevention","type":"heading","url":"/docs/ui/fraud/fraud-prevention#aml-and-compliance","content":"AML and compliance"},"815":{"id":"/docs/ui/fraud/fraud-prevention-7","page_id":"/docs/ui/fraud/fraud-prevention","type":"heading","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"Which product do I need?"},"816":{"id":"/docs/ui/fraud/fraud-prevention-8","page_id":"/docs/ui/fraud/fraud-prevention","type":"heading","url":"/docs/ui/fraud/fraud-prevention#products","content":"Products"},"817":{"id":"/docs/ui/fraud/fraud-prevention-9","page_id":"/docs/ui/fraud/fraud-prevention","type":"heading","url":"/docs/ui/fraud/fraud-prevention#faq","content":"FAQ"},"818":{"id":"/docs/ui/fraud/fraud-prevention-10","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention","content":"Ambriel is a comprehensive suite of fraud prevention and compliance solutions tailored for financial services, fintechs, iGaming operators, e-commerce platforms, retailers, and other digital businesses seeking effective risk management tools."},"819":{"id":"/docs/ui/fraud/fraud-prevention-11","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention","content":"Start here if you are new: pick the product area that matches your problem below, then follow its guide to integrate and go live. You can adopt one tool for a targeted need or combine them into a layered defense across every transaction."},"820":{"id":"/docs/ui/fraud/fraud-prevention-12","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#fraud-scoring-api","content":"The Fraud API is Ambriel's primary real-time decisioning endpoint. You submit transaction, customer, and session data in a single request and receive an enriched response with risk scores, triggered rules, and a recommended decision in milliseconds."},"821":{"id":"/docs/ui/fraud/fraud-prevention-13","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#fraud-scoring-api","content":"Use it when you need a synchronous approve-or-block answer at checkout, signup, or login. It consolidates digital footprinting, decisioning, and risk scoring into one streamlined response, so your backend makes one call instead of orchestrating five vendors."},"822":{"id":"/docs/ui/fraud/fraud-prevention-14","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#digital-footprint","content":"Digital Footprint reveals who is really behind a session by analyzing online behavior, device identity, location consistency, and contact-data reputation. The Email, Phone, and IP signals expose disposable addresses, breached credentials, VoIP burner numbers, and anonymized or high-risk networks before money moves."},"823":{"id":"/docs/ui/fraud/fraud-prevention-15","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#digital-footprint","content":"Use it when fake accounts, friendly-fraud chargebacks, or promo abuse keep slipping through. Read the Digital Footprint guide for the full signal catalog and collection setup."},"824":{"id":"/docs/ui/fraud/fraud-prevention-16","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#device-intelligence","content":"Device Intelligence tracks device attributes, behavioral biometrics, and interaction patterns across web and mobile sessions. By fingerprinting configurations, browser settings, and usage behavior, it exposes bots, device spoofing, emulators, and multi-accounting rings that rotate identities but reuse hardware."},"825":{"id":"/docs/ui/fraud/fraud-prevention-17","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#device-intelligence","content":"Use it when one attacker controls many accounts, or when automated credential stuffing and card testing spike. Pair it with velocity rules in the scoring engine to throttle repeat offenders automatically."},"826":{"id":"/docs/ui/fraud/fraud-prevention-18","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#scoring-engine-and-rules","content":"The Scoring Engine turns your risk policy into executable logic: custom rules over IP, customer, phone, email, BIN, and transaction attributes, combined with AND/OR/NOT operators into Approve, Review, and Reject outcomes. Analysts tune thresholds and actions without shipping code."},"827":{"id":"/docs/ui/fraud/fraud-prevention-19","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#scoring-engine-and-rules","content":"Use it when static vendor scores do not match your risk appetite, or when you need different policies per market, product line, or payment method. See Scoring Engine for rule types, score bands, and worked examples."},"828":{"id":"/docs/ui/fraud/fraud-prevention-20","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#transaction-review-queue","content":"The Transactions queue is where analysts work the output of the engine: every scored event with its decision, score, rule trace, and evidence panel in one searchable list. Triage review-band traffic, approve or overturn decisions with a recorded audit trail, and export case files for disputes and regulators."},"829":{"id":"/docs/ui/fraud/fraud-prevention-21","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#transaction-review-queue","content":"Use it when manual review is part of your flow, or when chargebacks demand evidence fast. The Transactions guide walks through filters, risk bands, and the daily triage routine."},"830":{"id":"/docs/ui/fraud/fraud-prevention-22","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#aml-and-compliance","content":"Ambriel's AML screening and monitoring tools simplify regulatory adherence while strengthening fraud detection. Watchlist and sanctions checks run alongside fraud scoring, so a single transaction view covers both financial-crime risk and compliance exposure."},"831":{"id":"/docs/ui/fraud/fraud-prevention-23","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#aml-and-compliance","content":"Use it when onboarding customers under KYC obligations, or when ongoing monitoring must flag sanctioned entities and suspicious patterns. These tools integrate with the Fraud API for a holistic prevention posture."},"832":{"id":"/docs/ui/fraud/fraud-prevention-24","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"Symptom"},"833":{"id":"/docs/ui/fraud/fraud-prevention-25","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"Product"},"834":{"id":"/docs/ui/fraud/fraud-prevention-26","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"Start with"},"835":{"id":"/docs/ui/fraud/fraud-prevention-27","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"Fake signups and disposable emails"},"836":{"id":"/docs/ui/fraud/fraud-prevention-28","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"Digital Footprint"},"837":{"id":"/docs/ui/fraud/fraud-prevention-29","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"Digital Footprint"},"838":{"id":"/docs/ui/fraud/fraud-prevention-30","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"One device running many accounts"},"839":{"id":"/docs/ui/fraud/fraud-prevention-31","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"Device Intelligence"},"840":{"id":"/docs/ui/fraud/fraud-prevention-32","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"Digital Footprint"},"841":{"id":"/docs/ui/fraud/fraud-prevention-33","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"Need a real-time approve-or-block answer"},"842":{"id":"/docs/ui/fraud/fraud-prevention-34","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"Fraud scoring API"},"843":{"id":"/docs/ui/fraud/fraud-prevention-35","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"Scoring Engine"},"844":{"id":"/docs/ui/fraud/fraud-prevention-36","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"Vendor scores don't match our risk appetite"},"845":{"id":"/docs/ui/fraud/fraud-prevention-37","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"Scoring Engine and rules"},"846":{"id":"/docs/ui/fraud/fraud-prevention-38","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"Scoring Engine"},"847":{"id":"/docs/ui/fraud/fraud-prevention-39","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"Review team drowning in manual checks"},"848":{"id":"/docs/ui/fraud/fraud-prevention-40","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"Transaction review queue"},"849":{"id":"/docs/ui/fraud/fraud-prevention-41","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"Transactions"},"850":{"id":"/docs/ui/fraud/fraud-prevention-42","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"Chargebacks need evidence packs"},"851":{"id":"/docs/ui/fraud/fraud-prevention-43","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"Transaction review queue"},"852":{"id":"/docs/ui/fraud/fraud-prevention-44","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"Transactions"},"853":{"id":"/docs/ui/fraud/fraud-prevention-45","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"Sanctions and watchlist obligations"},"854":{"id":"/docs/ui/fraud/fraud-prevention-46","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"AML and compliance"},"855":{"id":"/docs/ui/fraud/fraud-prevention-47","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"AML Compliance"},"856":{"id":"/docs/ui/fraud/fraud-prevention-48","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"type: info"},"857":{"id":"/docs/ui/fraud/fraud-prevention-49","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#which-product-do-i-need","content":"Most teams combine at least three layers: footprint signals for enrichment, scoring rules for automated decisions, and the review queue for human oversight. Start with scoring plus one signal source, then add layers as false positives and fraud losses dictate."},"858":{"id":"/docs/ui/fraud/fraud-prevention-50","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#faq","content":"Individually. Each product area works standalone — for example, lookup APIs for signup validation only — and they compose into a full risk stack when you are ready. Start with your most painful fraud vector and expand from there."},"859":{"id":"/docs/ui/fraud/fraud-prevention-51","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#faq","content":"The Fraud API plus the JavaScript agent gives you scored transactions with device and behavior signals in days. Lookup APIs for email, phone, and IP can ship even faster since they need no frontend changes."},"860":{"id":"/docs/ui/fraud/fraud-prevention-52","page_id":"/docs/ui/fraud/fraud-prevention","type":"text","url":"/docs/ui/fraud/fraud-prevention#faq","content":"No — it focuses it. Automated rules clear the obvious approves and rejects so analysts spend time only on ambiguous review-band cases, with full evidence and an audit trail for every decision."},"861":{"id":"/docs/ui/fraud/scoring-engine","page_id":"/docs/ui/fraud/scoring-engine","type":"page","content":"Scoring Engine","url":"/docs/ui/fraud/scoring-engine"},"862":{"id":"/docs/ui/fraud/scoring-engine-0","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine","content":"Learn how Ambriel scores each transaction with custom rules, score bands and decision states that approve, review or reject risk."},"863":{"id":"/docs/ui/fraud/scoring-engine-1","page_id":"/docs/ui/fraud/scoring-engine","type":"heading","url":"/docs/ui/fraud/scoring-engine#scoring-engine","content":"Scoring Engine"},"864":{"id":"/docs/ui/fraud/scoring-engine-2","page_id":"/docs/ui/fraud/scoring-engine","type":"heading","url":"/docs/ui/fraud/scoring-engine#how-is-the-score-calculated","content":"How is the score calculated?"},"865":{"id":"/docs/ui/fraud/scoring-engine-3","page_id":"/docs/ui/fraud/scoring-engine","type":"heading","url":"/docs/ui/fraud/scoring-engine#rule-types","content":"Rule Types"},"866":{"id":"/docs/ui/fraud/scoring-engine-4","page_id":"/docs/ui/fraud/scoring-engine","type":"heading","url":"/docs/ui/fraud/scoring-engine#conditions","content":"Conditions"},"867":{"id":"/docs/ui/fraud/scoring-engine-5","page_id":"/docs/ui/fraud/scoring-engine","type":"heading","url":"/docs/ui/fraud/scoring-engine#actions","content":"Actions"},"868":{"id":"/docs/ui/fraud/scoring-engine-6","page_id":"/docs/ui/fraud/scoring-engine","type":"heading","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"What do score bands mean?"},"869":{"id":"/docs/ui/fraud/scoring-engine-7","page_id":"/docs/ui/fraud/scoring-engine","type":"heading","url":"/docs/ui/fraud/scoring-engine#how-do-rules-interact-with-scores","content":"How do rules interact with scores?"},"870":{"id":"/docs/ui/fraud/scoring-engine-8","page_id":"/docs/ui/fraud/scoring-engine","type":"heading","url":"/docs/ui/fraud/scoring-engine#examples","content":"Examples"},"871":{"id":"/docs/ui/fraud/scoring-engine-9","page_id":"/docs/ui/fraud/scoring-engine","type":"heading","url":"/docs/ui/fraud/scoring-engine#faq","content":"FAQ"},"872":{"id":"/docs/ui/fraud/scoring-engine-10","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#scoring-engine","content":"The Scoring Engine evaluates every transaction against your custom rules and produces a 0–100 risk score plus an Approve, Review, or Reject decision. Rules inspect IP, customer, phone, email, BIN, and transaction attributes, combine with logical operators, and the highest-priority match sets the outcome reviewers see in the queue."},"873":{"id":"/docs/ui/fraud/scoring-engine-11","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#scoring-engine","content":"The Scoring Engine works by allowing you to define a set of rules that are evaluated for each transaction. Each rule has a set of conditions that are evaluated, and if all conditions are true, the rule is triggered. The triggered rule can then perform an action, such as setting a score, setting a state (Approve, Reject, Review), or adding a value to a list."},"874":{"id":"/docs/ui/fraud/scoring-engine-12","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#how-is-the-score-calculated","content":"Each transaction runs through your rule set in priority order. Every rule whose conditions all evaluate to true fires and applies its action — setting or adjusting the score, assigning a decision state, or tagging the transaction via a list. When several rules match, the engine resolves them by priority so the most specific or most severe rule wins, and the full trace of fired rules is stored as evidence on the Transactions row."},"875":{"id":"/docs/ui/fraud/scoring-engine-13","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#how-is-the-score-calculated","content":"type: info"},"876":{"id":"/docs/ui/fraud/scoring-engine-14","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#how-is-the-score-calculated","content":"Scores are deterministic: the same transaction data against the same rule set always yields the same score. That makes rule changes testable — clone a rule, adjust it, and replay recent traffic before promoting."},"877":{"id":"/docs/ui/fraud/scoring-engine-15","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#rule-types","content":"The following rule types are available:"},"878":{"id":"/docs/ui/fraud/scoring-engine-16","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#rule-types","content":"Rule Type"},"879":{"id":"/docs/ui/fraud/scoring-engine-17","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#rule-types","content":"Description"},"880":{"id":"/docs/ui/fraud/scoring-engine-18","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#rule-types","content":"IP Rule"},"881":{"id":"/docs/ui/fraud/scoring-engine-19","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#rule-types","content":"Evaluates the IP address of the transaction."},"882":{"id":"/docs/ui/fraud/scoring-engine-20","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#rule-types","content":"Customer Rule"},"883":{"id":"/docs/ui/fraud/scoring-engine-21","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#rule-types","content":"Evaluates the customer information associated with the transaction."},"884":{"id":"/docs/ui/fraud/scoring-engine-22","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#rule-types","content":"Phone Rule"},"885":{"id":"/docs/ui/fraud/scoring-engine-23","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#rule-types","content":"Evaluates the phone number associated with the transaction."},"886":{"id":"/docs/ui/fraud/scoring-engine-24","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#rule-types","content":"Email Rule"},"887":{"id":"/docs/ui/fraud/scoring-engine-25","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#rule-types","content":"Evaluates the email address associated with the transaction."},"888":{"id":"/docs/ui/fraud/scoring-engine-26","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#rule-types","content":"Bin Rule"},"889":{"id":"/docs/ui/fraud/scoring-engine-27","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#rule-types","content":"Evaluates the BIN (bank identification number) of the card associated with the transaction."},"890":{"id":"/docs/ui/fraud/scoring-engine-28","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#rule-types","content":"Transaction Rule"},"891":{"id":"/docs/ui/fraud/scoring-engine-29","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#rule-types","content":"Evaluates the transaction information, such as the amount or currency."},"892":{"id":"/docs/ui/fraud/scoring-engine-30","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#conditions","content":"Each rule can have multiple conditions. Conditions are evaluated using logical operators. The following logical operators are available:"},"893":{"id":"/docs/ui/fraud/scoring-engine-31","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#conditions","content":"Operator"},"894":{"id":"/docs/ui/fraud/scoring-engine-32","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#conditions","content":"Description"},"895":{"id":"/docs/ui/fraud/scoring-engine-33","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#conditions","content":"AND"},"896":{"id":"/docs/ui/fraud/scoring-engine-34","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#conditions","content":"Evaluates to true if all conditions are true."},"897":{"id":"/docs/ui/fraud/scoring-engine-35","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#conditions","content":"OR"},"898":{"id":"/docs/ui/fraud/scoring-engine-36","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#conditions","content":"Evaluates to true if any condition is true."},"899":{"id":"/docs/ui/fraud/scoring-engine-37","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#conditions","content":"NOT"},"900":{"id":"/docs/ui/fraud/scoring-engine-38","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#conditions","content":"Evaluates to true if the condition is false."},"901":{"id":"/docs/ui/fraud/scoring-engine-39","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#actions","content":"If a rule is triggered, the action associated with the rule is performed. The following actions are available:"},"902":{"id":"/docs/ui/fraud/scoring-engine-40","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#actions","content":"Action"},"903":{"id":"/docs/ui/fraud/scoring-engine-41","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#actions","content":"Description"},"904":{"id":"/docs/ui/fraud/scoring-engine-42","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#actions","content":"Set Score"},"905":{"id":"/docs/ui/fraud/scoring-engine-43","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#actions","content":"Sets the score of the transaction to a specified value."},"906":{"id":"/docs/ui/fraud/scoring-engine-44","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#actions","content":"Set State"},"907":{"id":"/docs/ui/fraud/scoring-engine-45","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#actions","content":"Sets the state of the transaction to a specified value (Approve, Reject, Review)."},"908":{"id":"/docs/ui/fraud/scoring-engine-46","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#actions","content":"Add to List"},"909":{"id":"/docs/ui/fraud/scoring-engine-47","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#actions","content":"Adds a value to a list associated with the transaction."},"910":{"id":"/docs/ui/fraud/scoring-engine-48","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"The numeric score maps to a decision band that drives the default action. Configure the thresholds to match your risk appetite; the standard interpretation is:"},"911":{"id":"/docs/ui/fraud/scoring-engine-49","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Band"},"912":{"id":"/docs/ui/fraud/scoring-engine-50","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Score"},"913":{"id":"/docs/ui/fraud/scoring-engine-51","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Meaning"},"914":{"id":"/docs/ui/fraud/scoring-engine-52","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Default decision"},"915":{"id":"/docs/ui/fraud/scoring-engine-53","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Low risk"},"916":{"id":"/docs/ui/fraud/scoring-engine-54","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"0–29"},"917":{"id":"/docs/ui/fraud/scoring-engine-55","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Signals look clean; no risk rules fired"},"918":{"id":"/docs/ui/fraud/scoring-engine-56","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Approve"},"919":{"id":"/docs/ui/fraud/scoring-engine-57","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Medium risk"},"920":{"id":"/docs/ui/fraud/scoring-engine-58","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"30–69"},"921":{"id":"/docs/ui/fraud/scoring-engine-59","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Suspicious indicators present but not conclusive"},"922":{"id":"/docs/ui/fraud/scoring-engine-60","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Review"},"923":{"id":"/docs/ui/fraud/scoring-engine-61","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"High risk"},"924":{"id":"/docs/ui/fraud/scoring-engine-62","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"70–100"},"925":{"id":"/docs/ui/fraud/scoring-engine-63","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Strong fraud signals or a block rule matched"},"926":{"id":"/docs/ui/fraud/scoring-engine-64","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Reject"},"927":{"id":"/docs/ui/fraud/scoring-engine-65","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#what-do-score-bands-mean","content":"Bands shown in the Transactions queue use these same cutoffs, so what analysts triage matches what the engine decided. Start with the defaults, then shift boundaries after measuring false-positive and fraud-catch rates over a few weeks of live traffic."},"928":{"id":"/docs/ui/fraud/scoring-engine-66","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#how-do-rules-interact-with-scores","content":"Rules and scores work as a pair: score actions position the transaction inside a band, while state actions can pin the decision regardless of the number. A rule that sets state Reject blocks the transaction even if no score action pushed it into the high band, and a Review state routes it to the manual queue for a human call. Priority ordering decides conflicts — place narrow, high-confidence block rules above broad informational ones so the severe outcome wins."},"929":{"id":"/docs/ui/fraud/scoring-engine-67","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#how-do-rules-interact-with-scores","content":"Lists add memory across transactions: a rule can tag a device, email domain, or BIN the first time it looks suspicious, and later rules can check list membership to escalate repeat offenders. This is how single-event signals from the Digital Footprint become velocity and repeat-offender logic without custom code."},"930":{"id":"/docs/ui/fraud/scoring-engine-68","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"The following example shows a rule that sets the score to 10 if the IP address of the transaction is from the United States and the transaction amount is greater than $100:"},"931":{"id":"/docs/ui/fraud/scoring-engine-69","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Rule Name"},"932":{"id":"/docs/ui/fraud/scoring-engine-70","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Rule Type"},"933":{"id":"/docs/ui/fraud/scoring-engine-71","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Conditions"},"934":{"id":"/docs/ui/fraud/scoring-engine-72","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Action"},"935":{"id":"/docs/ui/fraud/scoring-engine-73","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"US High Amount"},"936":{"id":"/docs/ui/fraud/scoring-engine-74","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"IP Rule"},"937":{"id":"/docs/ui/fraud/scoring-engine-75","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"IP Address is from United States AND Amount > 100"},"938":{"id":"/docs/ui/fraud/scoring-engine-76","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Set Score to 10"},"939":{"id":"/docs/ui/fraud/scoring-engine-77","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"The following example shows a rule that sets the state to Review if the customer's email address is not verified and the transaction amount is greater than $50:"},"940":{"id":"/docs/ui/fraud/scoring-engine-78","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Rule Name"},"941":{"id":"/docs/ui/fraud/scoring-engine-79","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Rule Type"},"942":{"id":"/docs/ui/fraud/scoring-engine-80","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Conditions"},"943":{"id":"/docs/ui/fraud/scoring-engine-81","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Action"},"944":{"id":"/docs/ui/fraud/scoring-engine-82","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Unverified Email"},"945":{"id":"/docs/ui/fraud/scoring-engine-83","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Email Rule"},"946":{"id":"/docs/ui/fraud/scoring-engine-84","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Email Address is not verified AND Amount > 50"},"947":{"id":"/docs/ui/fraud/scoring-engine-85","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Set State to Review"},"948":{"id":"/docs/ui/fraud/scoring-engine-86","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"The following example shows a rule that sets the score to 20 if the IP address of the transaction is not from the United States and the transaction amount is greater than $100 and the customer's phone number is not verified and the email address is not verified and the BIN is not from Visa:"},"949":{"id":"/docs/ui/fraud/scoring-engine-87","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Rule Name"},"950":{"id":"/docs/ui/fraud/scoring-engine-88","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Rule Type"},"951":{"id":"/docs/ui/fraud/scoring-engine-89","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Conditions"},"952":{"id":"/docs/ui/fraud/scoring-engine-90","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Action"},"953":{"id":"/docs/ui/fraud/scoring-engine-91","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"High Amount and Unverified Information"},"954":{"id":"/docs/ui/fraud/scoring-engine-92","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"IP Rule"},"955":{"id":"/docs/ui/fraud/scoring-engine-93","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"IP Address is not from United States AND Amount > 100 AND Phone Number is not verified AND Email Address is not verified AND BIN is not Visa"},"956":{"id":"/docs/ui/fraud/scoring-engine-94","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#examples","content":"Set Score to 20"},"957":{"id":"/docs/ui/fraud/scoring-engine-95","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#faq","content":"All matching rules fire and their trace is recorded, but priority order decides the final score and state. Put specific high-severity rules first so they override broader informational rules evaluated later."},"958":{"id":"/docs/ui/fraud/scoring-engine-96","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#faq","content":"Use score actions for graduated risk that bands can route, and state actions for hard policy — things that must always block or always review. Combining them lets the number reflect risk while the state enforces policy."},"959":{"id":"/docs/ui/fraud/scoring-engine-97","page_id":"/docs/ui/fraud/scoring-engine","type":"text","url":"/docs/ui/fraud/scoring-engine#faq","content":"Duplicate the rule, adjust the copy, and check its matches against recent transactions before swapping it into production. Watch the review-queue volume and overturn rate afterward to confirm the change helped."},"960":{"id":"/docs/ui/fraud/transactions","page_id":"/docs/ui/fraud/transactions","type":"page","content":"Transactions","url":"/docs/ui/fraud/transactions"},"961":{"id":"/docs/ui/fraud/transactions-0","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions","content":"Track every scored transaction in Ambriel: filter by risk level, review signals and decisions, then export cases for audit trails."},"962":{"id":"/docs/ui/fraud/transactions-1","page_id":"/docs/ui/fraud/transactions","type":"heading","url":"/docs/ui/fraud/transactions#transactions","content":"Transactions"},"963":{"id":"/docs/ui/fraud/transactions-2","page_id":"/docs/ui/fraud/transactions","type":"heading","url":"/docs/ui/fraud/transactions#what-the-page-shows","content":"What the page shows"},"964":{"id":"/docs/ui/fraud/transactions-3","page_id":"/docs/ui/fraud/transactions","type":"heading","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Filtering transactions"},"965":{"id":"/docs/ui/fraud/transactions-4","page_id":"/docs/ui/fraud/transactions","type":"heading","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Risk-band meanings"},"966":{"id":"/docs/ui/fraud/transactions-5","page_id":"/docs/ui/fraud/transactions","type":"heading","url":"/docs/ui/fraud/transactions#triaging-the-review-queue","content":"Triaging the review queue"},"967":{"id":"/docs/ui/fraud/transactions-6","page_id":"/docs/ui/fraud/transactions","type":"heading","url":"/docs/ui/fraud/transactions#sort-by-score-filter-to-review","content":"Sort by score, filter to Review"},"968":{"id":"/docs/ui/fraud/transactions-7","page_id":"/docs/ui/fraud/transactions","type":"heading","url":"/docs/ui/fraud/transactions#open-the-evidence-panel","content":"Open the evidence panel"},"969":{"id":"/docs/ui/fraud/transactions-8","page_id":"/docs/ui/fraud/transactions","type":"heading","url":"/docs/ui/fraud/transactions#decide-approve-reject-or-escalate","content":"Decide: approve, reject, or escalate"},"970":{"id":"/docs/ui/fraud/transactions-9","page_id":"/docs/ui/fraud/transactions","type":"heading","url":"/docs/ui/fraud/transactions#feed-the-outcome-back-into-rules","content":"Feed the outcome back into rules"},"971":{"id":"/docs/ui/fraud/transactions-10","page_id":"/docs/ui/fraud/transactions","type":"heading","url":"/docs/ui/fraud/transactions#export-and-audit-trail","content":"Export and audit trail"},"972":{"id":"/docs/ui/fraud/transactions-11","page_id":"/docs/ui/fraud/transactions","type":"heading","url":"/docs/ui/fraud/transactions#faq","content":"FAQ"},"973":{"id":"/docs/ui/fraud/transactions-12","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#transactions","content":"The Transactions page is your operational queue for every scored payment, signup, and login: each row shows the final decision, the risk score, and the signals behind it. Use it to triage review-band traffic daily, investigate individual cases with full evidence, and export audit-ready records for compliance."},"974":{"id":"/docs/ui/fraud/transactions-13","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#what-the-page-shows","content":"Each transaction row summarizes the full output of the Scoring Engine in one line: a unique transaction ID, timestamp, customer reference, amount and currency, payment method, the final decision state (Approve, Review, or Reject), and a numeric risk score from 0 to 100. Opening a row reveals the evidence panel — which rules fired, the Digital Footprint signals attached to the session (device, IP, email, phone), and the complete decision history including manual overrides and analyst notes."},"975":{"id":"/docs/ui/fraud/transactions-14","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#what-the-page-shows","content":"type: info"},"976":{"id":"/docs/ui/fraud/transactions-15","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#what-the-page-shows","content":"Decisions shown here are final: automated rule outcomes plus any manual review actions. When a reviewer changes a state, the original score and rule trace are preserved so audits always show what the engine decided first."},"977":{"id":"/docs/ui/fraud/transactions-16","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#what-the-page-shows","content":"Scores and states update in near real time as new events stream in, so the queue always reflects the latest posture. High-risk spikes — for example a burst of transactions from one device or IP range — surface at the top when you sort by score descending, which is the recommended default view for a morning triage shift."},"978":{"id":"/docs/ui/fraud/transactions-17","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Use filters to narrow the queue to the slice you need to work. Combine several filters at once — for instance, state Review plus score above 70 plus the last 24 hours — to build a focused review list."},"979":{"id":"/docs/ui/fraud/transactions-18","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Filter"},"980":{"id":"/docs/ui/fraud/transactions-19","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Use it to"},"981":{"id":"/docs/ui/fraud/transactions-20","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Decision state (Approve / Review / Reject)"},"982":{"id":"/docs/ui/fraud/transactions-21","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Work the manual queue: start with Review, then spot-check a sample of Approve and Reject"},"983":{"id":"/docs/ui/fraud/transactions-22","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Risk score range"},"984":{"id":"/docs/ui/fraud/transactions-23","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Focus on a band, e.g. 70–100 for urgent review or 30–69 for secondary checks"},"985":{"id":"/docs/ui/fraud/transactions-24","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Date and time range"},"986":{"id":"/docs/ui/fraud/transactions-25","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Reconstruct what happened during an incident window or reconcile a settlement period"},"987":{"id":"/docs/ui/fraud/transactions-26","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Customer reference or email"},"988":{"id":"/docs/ui/fraud/transactions-27","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Pull every transaction from one buyer for a dispute or chargeback investigation"},"989":{"id":"/docs/ui/fraud/transactions-28","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Amount range"},"990":{"id":"/docs/ui/fraud/transactions-29","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Isolate high-value exposure first when review capacity is limited"},"991":{"id":"/docs/ui/fraud/transactions-30","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Payment method / BIN"},"992":{"id":"/docs/ui/fraud/transactions-31","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Chase card-testing patterns tied to one issuer or card range"},"993":{"id":"/docs/ui/fraud/transactions-32","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"IP address or country"},"994":{"id":"/docs/ui/fraud/transactions-33","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Investigate geo-mismatch clusters or traffic from sanctioned regions"},"995":{"id":"/docs/ui/fraud/transactions-34","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Device ID"},"996":{"id":"/docs/ui/fraud/transactions-35","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Find multi-accounting rings reusing the same device across identities"},"997":{"id":"/docs/ui/fraud/transactions-36","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Rule name"},"998":{"id":"/docs/ui/fraud/transactions-37","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"See everything one rule caught to tune it or measure its precision"},"999":{"id":"/docs/ui/fraud/transactions-38","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#filtering-transactions","content":"Saved views keep your most-used combinations one click away. A typical team keeps three: \"Morning review\" (Review state, score 50+, last 24h), \"High value\" (amount above threshold, any state), and \"Disputes\" (filtered by customer on demand)."},"1000":{"id":"/docs/ui/fraud/transactions-39","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Scores map to decision bands that tell you how to act at a glance. Your exact thresholds are configurable in the Scoring Engine, but the default semantics are:"},"1001":{"id":"/docs/ui/fraud/transactions-40","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Band"},"1002":{"id":"/docs/ui/fraud/transactions-41","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Score"},"1003":{"id":"/docs/ui/fraud/transactions-42","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Meaning"},"1004":{"id":"/docs/ui/fraud/transactions-43","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Recommended action"},"1005":{"id":"/docs/ui/fraud/transactions-44","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Low risk"},"1006":{"id":"/docs/ui/fraud/transactions-45","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"0–29"},"1007":{"id":"/docs/ui/fraud/transactions-46","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Signals look clean; no rule fired or only informational rules matched"},"1008":{"id":"/docs/ui/fraud/transactions-47","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Auto-approve; sample periodically for QA"},"1009":{"id":"/docs/ui/fraud/transactions-48","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Medium risk"},"1010":{"id":"/docs/ui/fraud/transactions-49","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"30–69"},"1011":{"id":"/docs/ui/fraud/transactions-50","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"One or more risk signals present but not conclusive"},"1012":{"id":"/docs/ui/fraud/transactions-51","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Route to manual review or step-up authentication"},"1013":{"id":"/docs/ui/fraud/transactions-52","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"High risk"},"1014":{"id":"/docs/ui/fraud/transactions-53","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"70–100"},"1015":{"id":"/docs/ui/fraud/transactions-54","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Strong fraud indicators or a Reject rule matched"},"1016":{"id":"/docs/ui/fraud/transactions-55","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Block or hold; review before any release"},"1017":{"id":"/docs/ui/fraud/transactions-56","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#risk-band-meanings","content":"Bands are guidance, not verdicts: a low-score transaction with a fresh dispute still deserves a look, and a high-score transaction from a known VIP may warrant a call rather than an outright cancel."},"1018":{"id":"/docs/ui/fraud/transactions-57","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#sort-by-score-filter-to-review","content":"Start each shift with decision state set to Review and sort by score descending. The riskiest cases needing a human decision sit at the top."},"1019":{"id":"/docs/ui/fraud/transactions-58","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#open-the-evidence-panel","content":"Check which rules fired, the score breakdown, and the attached footprint: device reputation, IP geolocation versus billing country, email age and breach exposure, and phone carrier and line type."},"1020":{"id":"/docs/ui/fraud/transactions-59","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#decide-approve-reject-or-escalate","content":"Approve genuine buyers, reject clear fraud, and escalate edge cases with a note. Every action records who decided, when, and why, so the next reviewer sees the full trail."},"1021":{"id":"/docs/ui/fraud/transactions-60","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#feed-the-outcome-back-into-rules","content":"If a pattern repeats — the same BIN range, device, or email domain — take it to the Scoring Engine and tighten or add a rule so the next wave is handled automatically."},"1022":{"id":"/docs/ui/fraud/transactions-61","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#export-and-audit-trail","content":"Select any set of transactions and export them to CSV for chargeback representment, internal reporting, or regulator requests. Each export includes the score, the decision state, the rules that fired, manual actions with analyst identities and timestamps, and the linked footprint evidence. Because the original automated decision is stored separately from later manual overrides, auditors can always distinguish what the engine decided from what a human changed — which is exactly what dispute and compliance reviews require."},"1023":{"id":"/docs/ui/fraud/transactions-62","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#faq","content":"A Review state means a rule matched with a review action, or the score landed inside your configured review band. Open the evidence panel to see exactly which rule fired, then approve or reject manually — the decision and your note are recorded permanently."},"1024":{"id":"/docs/ui/fraud/transactions-63","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#faq","content":"Yes. Reviewers with the right permissions can move a transaction between Approve, Review, and Reject. The change is appended to the decision history with who made it and when; the original engine decision is never overwritten."},"1025":{"id":"/docs/ui/fraud/transactions-64","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#faq","content":"Retention follows your plan and regional settings. Transactions remain searchable and exportable for the full retention window, after which they are archived or purged according to your data policy."},"1026":{"id":"/docs/ui/fraud/transactions-65","page_id":"/docs/ui/fraud/transactions","type":"text","url":"/docs/ui/fraud/transactions#faq","content":"Filter by the shared attribute — device ID, IP range, email domain, or BIN — across a wide date range, then sort by score. Linked rows sharing one device or network with different identities are the classic multi-accounting pattern; export the set as a case file and tighten a rule in the scoring engine."},"1027":{"id":"/docs/ui/integration/bigcommerce","page_id":"/docs/ui/integration/bigcommerce","type":"page","content":"BigCommerce","url":"/docs/ui/integration/bigcommerce"},"1028":{"id":"/docs/ui/integration/bigcommerce-0","page_id":"/docs/ui/integration/bigcommerce","type":"text","url":"/docs/ui/integration/bigcommerce","content":"Connect Ambriel fraud prevention to BigCommerce: screen orders, verify buyers and block fraudulent payments with guided setup."},"1029":{"id":"/docs/ui/integration/bigcommerce-1","page_id":"/docs/ui/integration/bigcommerce","type":"heading","url":"/docs/ui/integration/bigcommerce#in-progress","content":"In Progress"},"1030":{"id":"/docs/ui/integration/bigcommerce-2","page_id":"/docs/ui/integration/bigcommerce","type":"text","url":"/docs/ui/integration/bigcommerce#in-progress","content":"This page is currently being worked on and will be available soon."},"1031":{"id":"/docs/ui/integration","page_id":"/docs/ui/integration","type":"page","content":"Getting Started","url":"/docs/ui/integration"},"1032":{"id":"/docs/ui/integration-0","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration","content":"Learn how to integrate Ambriel with your stack: REST APIs, the JavaScript agent and no-code plugins for major ecommerce platforms."},"1033":{"id":"/docs/ui/integration-1","page_id":"/docs/ui/integration","type":"heading","url":"/docs/ui/integration#api-reference","content":"API Reference"},"1034":{"id":"/docs/ui/integration-2","page_id":"/docs/ui/integration","type":"heading","url":"/docs/ui/integration#javascript-agent","content":"Javascript Agent"},"1035":{"id":"/docs/ui/integration-3","page_id":"/docs/ui/integration","type":"heading","url":"/docs/ui/integration#e-commerce-plugins","content":"E-commerce Plugins"},"1036":{"id":"/docs/ui/integration-4","page_id":"/docs/ui/integration","type":"heading","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"REST vs JS agent vs plugin — which should you choose?"},"1037":{"id":"/docs/ui/integration-5","page_id":"/docs/ui/integration","type":"heading","url":"/docs/ui/integration#whats-next","content":"What's Next?"},"1038":{"id":"/docs/ui/integration-6","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration","content":"Ambriel provides a range of integration options to help you get started quickly. Whether you're building a custom integration or using one of our pre-built plugins, we've got you covered."},"1039":{"id":"/docs/ui/integration-7","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration","content":"By integrating Ambriel with your existing services, you can create a seamless experience for integration. You can use Ambriel as if it were your own product, without needing to map any data or use new identifiers."},"1040":{"id":"/docs/ui/integration-8","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration","content":"You can use your own identifiers, such as customer_id, order_id, transaction_id, and more. This makes it easy to incorporate Ambriel into your existing workflows and processes, without having to make significant changes to your code or infrastructure."},"1041":{"id":"/docs/ui/integration-9","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#api-reference","content":"If you're looking to build a custom integration, our API Reference is the perfect place to start. You'll find detailed documentation on all of our endpoints, including examples and code snippets to help you get started."},"1042":{"id":"/docs/ui/integration-10","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#javascript-agent","content":"Our Javascript Agent provides a simple way to integrate Ambriel with your web application. You can use it to capture user data, track events, and trigger fraud checks."},"1043":{"id":"/docs/ui/integration-11","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#e-commerce-plugins","content":"We also provide pre-built plugins for popular e-commerce platforms like Woocommerce, Wix, Shopify, and BigCommerce. These plugins make it easy to integrate Ambriel with your online store, and provide a seamless experience for your customers."},"1044":{"id":"/docs/ui/integration-12","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"REST API"},"1045":{"id":"/docs/ui/integration-13","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"JavaScript agent"},"1046":{"id":"/docs/ui/integration-14","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"E-commerce 