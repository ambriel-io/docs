-choose","content":"Full — every field, rule, and response code"},"785":{"id":"/docs/ui/integration-29","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"Client-side collection, scored server-side"},"786":{"id":"/docs/ui/integration-30","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"Fixed mapping, fastest time to value"},"787":{"id":"/docs/ui/integration-31","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"type: info"},"788":{"id":"/docs/ui/integration-32","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"title: Combine them"},"789":{"id":"/docs/ui/integration-33","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#rest-vs-js-agent-vs-plugin--which-should-you-choose","content":"Most setups pair the JavaScript agent (device and behavior signals) with REST scoring (server-side decisions). The plugin path already wires both together for supported platforms."},"790":{"id":"/docs/ui/integration-34","page_id":"/docs/ui/integration","type":"text","url":"/docs/ui/integration#whats-next","content":"Once you've chosen an integration method, you can start building your Ambriel integration. If you have any questions or need help along the way, our support team is here to help."},"791":{"id":"/docs/ui/integration/js-agent","page_id":"/docs/ui/integration/js-agent","type":"page","content":"JavaScript Agent","url":"/docs/ui/integration/js-agent"},"792":{"id":"/docs/ui/integration/js-agent-0","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent","content":"Embed the Ambriel JavaScript agent in your web app: collect device intelligence and score sessions client-side with minimal code."},"793":{"id":"/docs/ui/integration/js-agent-1","page_id":"/docs/ui/integration/js-agent","type":"heading","url":"/docs/ui/integration/js-agent#how-it-works","content":"How it works"},"794":{"id":"/docs/ui/integration/js-agent-2","page_id":"/docs/ui/integration/js-agent","type":"heading","url":"/docs/ui/integration/js-agent#installation","content":"Installation"},"795":{"id":"/docs/ui/integration/js-agent-3","page_id":"/docs/ui/integration/js-agent","type":"heading","url":"/docs/ui/integration/js-agent#add-the-tracking-snippet","content":"Add the tracking snippet"},"796":{"id":"/docs/ui/integration/js-agent-4","page_id":"/docs/ui/integration/js-agent","type":"heading","url":"/docs/ui/integration/js-agent#save-the-session-id-on-your-backend","content":"Save the session ID on your backend"},"797":{"id":"/docs/ui/integration/js-agent-5","page_id":"/docs/ui/integration/js-agent","type":"heading","url":"/docs/ui/integration/js-agent#attach-the-session-id-when-scoring","content":"Attach the session ID when scoring"},"798":{"id":"/docs/ui/integration/js-agent-6","page_id":"/docs/ui/integration/js-agent","type":"heading","url":"/docs/ui/integration/js-agent#faq","content":"FAQ"},"799":{"id":"/docs/ui/integration/js-agent-7","page_id":"/docs/ui/integration/js-agent","type":"heading","url":"/docs/ui/integration/js-agent#next-steps","content":"Next steps"},"800":{"id":"/docs/ui/integration/js-agent-8","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent","content":"The JavaScript Agent collects device intelligence in the browser and links it to your server-side transactions through a session ID: the snippet below fingerprints the visitor, you persist the session ID next to your own user session, and you attach it to every /v1/transactions/ call so the scoring engine sees device and order together."},"801":{"id":"/docs/ui/integration/js-agent-9","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#how-it-works","content":"Browser — ambriel.js fingerprints the device and returns a session ID."},"802":{"id":"/docs/ui/integration/js-agent-10","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#how-it-works","content":"Your backend — you save that session ID alongside your own user session."},"803":{"id":"/docs/ui/integration/js-agent-11","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#how-it-works","content":"Checkout — you include the session ID in the transaction payload, and Ambriel scores device + order as one."},"804":{"id":"/docs/ui/integration/js-agent-12","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#how-it-works","content":"title: Keep your API key server-side"},"805":{"id":"/docs/ui/integration/js-agent-13","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#how-it-works","content":"type: warning"},"806":{"id":"/docs/ui/integration/js-agent-14","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#how-it-works","content":"The session ID is public by design (it lives in the browser). Your x-api-key, however, must never appear in frontend code — all /v1/* calls below run on your backend, with the key in an environment variable."},"807":{"id":"/docs/ui/integration/js-agent-15","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#add-the-tracking-snippet","content":"Paste this before the closing </head> tag. It loads ambriel.js asynchronously, so it never blocks your page:"},"808":{"id":"/docs/ui/integration/js-agent-16","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#save-the-session-id-on-your-backend","content":"Expose a POST /save-ambriel-session endpoint that stores the ID next to your own user session. Pick your stack once — both code blocks below follow your choice:"},"809":{"id":"/docs/ui/integration/js-agent-17","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#attach-the-session-id-when-scoring","content":"When the order completes, read the stored ID back and send it as session to POST /v1/transactions/. The tab selection follows your choice above:"},"810":{"id":"/docs/ui/integration/js-agent-18","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#attach-the-session-id-when-scoring","content":"Put the key in config/services.php under services.ambriel.key (backed by an AMBRIEL_API_KEY env var), so it never lands in version control."},"811":{"id":"/docs/ui/integration/js-agent-19","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#faq","content":"Then there is no session ID to attach — send the transaction without session. You still get rule, velocity and list screening; you only lose the device-intelligence signals for that order."},"812":{"id":"/docs/ui/integration/js-agent-20","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#faq","content":"A session covers one browsing session. Request a fresh ID on each visit (ambriel('create')); never reuse IDs across users or devices."},"813":{"id":"/docs/ui/integration/js-agent-21","page_id":"/docs/ui/integration/js-agent","type":"text","url":"/docs/ui/integration/js-agent#faq","content":"Yes. Call ambriel('create') once after the snippet loads (e.g. in your app bootstrap), then read ambriel.getSession() whenever you need the ID — no page reload required."},"814":{"id":"/docs/ui/integration/shopify","page_id":"/docs/ui/integration/shopify","type":"page","content":"Shopify","url":"/docs/ui/integration/shopify"},"815":{"id":"/docs/ui/integration/shopify-0","page_id":"/docs/ui/integration/shopify","type":"text","url":"/docs/ui/integration/shopify","content":"Connect Ambriel fraud prevention to Shopify: score every checkout, screen customers and stop chargebacks with quick guided setup."},"816":{"id":"/docs/ui/integration/shopify-1","page_id":"/docs/ui/integration/shopify","type":"heading","url":"/docs/ui/integration/shopify#in-progress","content":"In Progress"},"817":{"id":"/docs/ui/integration/shopify-2","page_id":"/docs/ui/integration/shopify","type":"text","url":"/docs/ui/integration/shopify#in-progress","content":"This page is currently being worked on and will be available soon."},"818":{"id":"/docs/ui/integration/wix","page_id":"/docs/ui/integration/wix","type":"page","content":"Wix","url":"/docs/ui/integration/wix"},"819":{"id":"/docs/ui/integration/wix-0","page_id":"/docs/ui/integration/wix","type":"text","url":"/docs/ui/integration/wix","content":"Connect Ambriel fraud prevention to your Wix store: screen orders, verify customers and block risky transactions with guided setup."},"820":{"id":"/docs/ui/integration/wix-1","page_id":"/docs/ui/integration/wix","type":"heading","url":"/docs/ui/integration/wix#in-progress","content":"In Progress"},"821":{"id":"/docs/ui/integration/wix-2","page_id":"/docs/ui/integration/wix","type":"text","url":"/docs/ui/integration/wix#in-progress","content":"This page is currently being worked on and will be available soon."},"822":{"id":"/docs/ui/integration/woocommerce","page_id":"/docs/ui/integration/woocommerce","type":"page","content":"WooCommerce","url":"/docs/ui/integration/woocommerce"},"823":{"id":"/docs/ui/integration/woocommerce-0","page_id":"/docs/ui/integration/woocommerce","type":"text","url":"/docs/ui/integration/woocommerce","content":"Connect Ambriel fraud prevention to WooCommerce: score orders, verify customers and reduce chargebacks with quick guided setup."},"824":{"id":"/docs/ui/integration/woocommerce-1","page_id":"/docs/ui/integration/woocommerce","type":"heading","url":"/docs/ui/integration/woocommerce#in-progress","content":"In Progress"},"825":{"id":"/docs/ui/integration/woocommerce-2","page_id":"/docs/ui/integration/woocommerce","type":"text","url":"/docs/ui/integration/woocommerce#in-progress","content":"This page is currently being worked on and will be available soon."},"826":{"id":"/docs/ui/kyb/risk-assessment","page_id":"/docs/ui/kyb/risk-assessment","type":"page","content":"Risk Assessment","url":"/docs/ui/kyb/risk-assessment"},"827":{"id":"/docs/ui/kyb/risk-assessment-0","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment","content":"Verify business identities with KYB risk assessment: company checks, ownership mapping, sanctions screening and continuous monitoring."},"828":{"id":"/docs/ui/kyb/risk-assessment-1","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#what-is-kyb-compliance","content":"What is KYB compliance?"},"829":{"id":"/docs/ui/kyb/risk-assessment-2","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#what-does-ambriels-kyb-risk-assessment-solution-do","content":"What does Ambriel's KYB Risk Assessment solution do?"},"830":{"id":"/docs/ui/kyb/risk-assessment-3","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#screening","content":"Screening"},"831":{"id":"/docs/ui/kyb/risk-assessment-4","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#monitoring","content":"Monitoring"},"832":{"id":"/docs/ui/kyb/risk-assessment-5","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#data-management","content":"Data Management"},"833":{"id":"/docs/ui/kyb/risk-assessment-6","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#how-does-a-kyb-risk-assessment-work-in-practice","content":"How does a KYB risk assessment work in practice?"},"834":{"id":"/docs/ui/kyb/risk-assessment-7","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#verify-the-company-exists","content":"Verify the company exists"},"835":{"id":"/docs/ui/kyb/risk-assessment-8","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#map-ownership-and-control","content":"Map ownership and control"},"836":{"id":"/docs/ui/kyb/risk-assessment-9","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#screen-the-entity-and-its-people","content":"Screen the entity and its people"},"837":{"id":"/docs/ui/kyb/risk-assessment-10","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#score-decide-and-monitor","content":"Score, decide, and monitor"},"838":{"id":"/docs/ui/kyb/risk-assessment-11","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"How do the signals combine into a score?"},"839":{"id":"/docs/ui/kyb/risk-assessment-12","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#how-does-it-work-technically","content":"How does it work technically?"},"840":{"id":"/docs/ui/kyb/risk-assessment-13","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#frequently-asked-questions","content":"Frequently asked questions"},"841":{"id":"/docs/ui/kyb/risk-assessment-14","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#what-is-kyb-compliance","content":"The Financial Action Task Force (FATF) recommends that countries implement effective Anti-Money Laundering (AML) and Combating the Financing of Terrorism (CFT) regulations. The European Union's 5th and 6th Anti-Money Laundering Directives (AMLD5/6) also require businesses to verify the identity of corporate entities, assess their risk profiles, and screen against global sanction lists, PEP (Politically Exposed Persons) databases, and high-risk profiles."},"842":{"id":"/docs/ui/kyb/risk-assessment-15","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#what-is-kyb-compliance","content":"In practice, that means three duties for every business customer: prove the company exists and is who it claims to be, understand who owns and controls it, and keep watching its risk profile for as long as the relationship lasts."},"843":{"id":"/docs/ui/kyb/risk-assessment-16","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#what-does-ambriels-kyb-risk-assessment-solution-do","content":"Ambriel's KYB risk assessment solution is designed to help businesses verify business identities and assess their risk exposure. It does this by providing real-time screening, monitoring, and data management capabilities."},"844":{"id":"/docs/ui/kyb/risk-assessment-17","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#screening","content":"The KYB API screens businesses against global sanction lists, PEP databases, and high-risk profiles. This ensures that businesses are compliant with KYB regulations and can assess potential risks associated with business partners and customers."},"845":{"id":"/docs/ui/kyb/risk-assessment-18","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#monitoring","content":"The KYB API also provides continuous monitoring, alerting businesses to any changes in a business entity's compliance status or risk profile over time."},"846":{"id":"/docs/ui/kyb/risk-assessment-19","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#data-management","content":"The KYB API provides a secure and reliable way to manage business data, ensuring that it is up-to-date and accurate. Additionally, all searches and results are stored in a secure and tamper-proof log for 5 years, providing a complete audit trail."},"847":{"id":"/docs/ui/kyb/risk-assessment-20","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-does-a-kyb-risk-assessment-work-in-practice","content":"Follow a new business customer — \"Nordvik Trading OÜ\", a supposedly Estonian wholesaler applying for a merchant account — through a full assessment. Each step adds signals, and the signals combine into a score your policy can act on."},"848":{"id":"/docs/ui/kyb/risk-assessment-21","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#verify-the-company-exists","content":"Pull the registration record: legal name, number, status, incorporation date, registered address, and declared activity. Nordvik exists in the registry — but it was incorporated 4 months ago and its declared wholesale activity has no website, no premises photos, and no trade history."},"849":{"id":"/docs/ui/kyb/risk-assessment-22","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#map-ownership-and-control","content":"Resolve directors, shareholders, and ultimate beneficial owners (UBOs), then screen each person against sanctions, PEP, and crime lists. Nordvik's sole director is a 21-year-old nominee appearing as director of 14 other recently formed companies — a classic shell-company pattern."},"850":{"id":"/docs/ui/kyb/risk-assessment-23","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#screen-the-entity-and-its-people","content":"Run the company and every UBO against sanctions, PEP, crime, and adverse-media lists. The company itself is not listed, but one UBO's name scores 0.82 against a crime-list profile with a matching nationality and birth year — a possible match needing enhanced review."},"851":{"id":"/docs/ui/kyb/risk-assessment-24","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#score-decide-and-monitor","content":"Combine existence, ownership, and screening signals into a risk score, apply your policy (approve, approve with limits, or decline), and keep the entity monitored so new listings or status changes raise alerts automatically."},"852":{"id":"/docs/ui/kyb/risk-assessment-25","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"The table below shows how Nordvik's signals translate into a worked risk score. Weights are illustrative — calibrate them to your own risk appetite."},"853":{"id":"/docs/ui/kyb/risk-assessment-26","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"Signal"},"854":{"id":"/docs/ui/kyb/risk-assessment-27","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"Finding for Nordvik"},"855":{"id":"/docs/ui/kyb/risk-assessment-28","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"Points (0–25 each)"},"856":{"id":"/docs/ui/kyb/risk-assessment-29","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"Company existence and age"},"857":{"id":"/docs/ui/kyb/risk-assessment-30","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"Registered but only 4 months old, no verifiable premises"},"858":{"id":"/docs/ui/kyb/risk-assessment-31","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"18"},"859":{"id":"/docs/ui/kyb/risk-assessment-32","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"Ownership transparency"},"860":{"id":"/docs/ui/kyb/risk-assessment-33","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"Nominee director shared across 14 companies, UBO unclear"},"861":{"id":"/docs/ui/kyb/risk-assessment-34","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"22"},"862":{"id":"/docs/ui/kyb/risk-assessment-35","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"Sanctions and crime screening"},"863":{"id":"/docs/ui/kyb/risk-assessment-36","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"Possible (0.82) crime-list match on a UBO"},"864":{"id":"/docs/ui/kyb/risk-assessment-37","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"16"},"865":{"id":"/docs/ui/kyb/risk-assessment-38","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"Adverse media and activity"},"866":{"id":"/docs/ui/kyb/risk-assessment-39","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"No website, no trade history, no digital footprint"},"867":{"id":"/docs/ui/kyb/risk-assessment-40","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"14"},"868":{"id":"/docs/ui/kyb/risk-assessment-41","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"Total risk score"},"869":{"id":"/docs/ui/kyb/risk-assessment-42","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"70 / 100 — high risk"},"870":{"id":"/docs/ui/kyb/risk-assessment-43","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"70"},"871":{"id":"/docs/ui/kyb/risk-assessment-44","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"At 70/100, a typical policy routes Nordvik to enhanced due diligence: request certified ownership documents, verify source of funds, and get senior sign-off — or decline the merchant account if documents do not arrive. A long-established manufacturer with transparent owners and zero list hits would instead score under 20 and pass straight through."},"872":{"id":"/docs/ui/kyb/risk-assessment-45","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"type: warning"},"873":{"id":"/docs/ui/kyb/risk-assessment-46","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"title: A clean registry record is not a clean bill of health"},"874":{"id":"/docs/ui/kyb/risk-assessment-47","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"Shell companies are usually properly registered — that is the point. Registration proves existence, not legitimacy. Ownership opacity, nominee patterns, and missing economic substance are what separate a real business from a front."},"875":{"id":"/docs/ui/kyb/risk-assessment-48","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-does-it-work-technically","content":"The KYB API integrates seamlessly with the Fraud API, providing a holistic approach to business risk assessment and financial crime prevention. Score the onboarding transaction for fraud signals while KYB verifies the business behind it, and hold funds or limit activity when either side fires. The KYB API is designed to be compatible with the Anti-Money Laundering Directive (AMLD5/6) of the European Union, as well as the recommendations of the Financial Action Task Force (FATF)."},"876":{"id":"/docs/ui/kyb/risk-assessment-49","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#frequently-asked-questions","content":"At minimum: certified certificate of incorporation, memorandum and articles, a current shareholder register, photo ID for every UBO above your threshold (commonly 25%), and proof of address for the operating premises. Escalate anything inconsistent to a compliance officer before onboarding."},"877":{"id":"/docs/ui/kyb/risk-assessment-50","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#frequently-asked-questions","content":"Treat 0.6–0.9 scores as enhanced-review territory: collect extra identifiers, compare nationality, birth year, and addresses, and set a review date. Only freeze or exit when the match firms up or your policy's sanctions rule triggers — but never ignore it."},"878":{"id":"/docs/ui/kyb/risk-assessment-51","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#frequently-asked-questions","content":"All searches, scores, documents, and decisions live in the tamper-proof log for 5 years, so a regulator can replay exactly what you knew and when you knew it."},"879":{"id":"/docs/ui/kyb/strategies","page_id":"/docs/ui/kyb/strategies","type":"page","content":"KYB Risk Scoring Strategies","url":"/docs/ui/kyb/strategies"},"880":{"id":"/docs/ui/kyb/strategies-0","page_id":"/docs/ui/kyb/strategies","type":"text","url":"/docs/ui/kyb/strategies","content":"Learn how Ambriel scores company risk: business-signal rules, weighted strategies and KYB assessments tuned to your own policy."},"881":{"id":"/docs/ui/kyb/strategies-1","page_id":"/docs/ui/kyb/strategies","type":"heading","url":"/docs/ui/kyb/strategies#kyb-risk-scoring-strategies","content":"KYB Risk Scoring Strategies"},"882":{"id":"/docs/ui/kyb/strategies-2","page_id":"/docs/ui/kyb/strategies","type":"heading","url":"/docs/ui/kyb/strategies#how-rules-work","content":"How Rules Work"},"883":{"id":"/docs/ui/kyb/strategies-3","page_id":"/docs/ui/kyb/strategies","type":"heading","url":"/docs/ui/kyb/strategies#risk-matrix-reference","content":"Risk Matrix Reference"},"884":{"id":"/docs/ui/kyb/strategies-4","page_id":"/docs/ui/kyb/strategies","type":"heading","url":"/docs/ui/kyb/strategies#three-scoring-strategies","content":"Three Scoring Strategies"},"885":{"id":"/docs/ui/kyb/strategies-5","page_id":"/docs/ui/kyb/strategies","type":"heading","url":"/docs/ui/kyb/strategies#strategy-1-cumulative-risk-sum-of-scores","content":"Strategy 1: Cumulative Risk (Sum of Scores)"},"886":{"id":"/docs/ui/kyb/strategies-6","page_id":"/docs/ui/kyb/strategies","type":"heading","url":"/docs/ui/kyb/strategies#how-it-works","content":"How It Works"},"887":{"id":"/docs/ui/kyb/strategies-7","page_id":"/docs/ui/kyb/strategies","type":"heading","url":"/docs/ui/kyb/strategies#formula","content":"Formula"},"888":{"id":"/docs/ui/kyb/strategies-8","page_id":"/docs/ui/kyb/strategies","type":"heading","url":"/docs/ui/kyb/strategies#real-world-example","content":"Real-World Example"},"889":{"id":"/docs/ui/kyb/strategies-9","page_id":"/docs/ui/kyb/strategies","type":"heading","url":"/docs/ui/kyb/strategies#configuration-options","content":"Configuration Options"},"890":{"id":"/docs/ui/kyb/strategies-10","page_id":"/docs/ui/kyb/strategies","type":"heading","url":"/docs/ui/kyb/strategies#best-use-cases","content":"Best Use Cases"},"891":{"id":"/docs/ui/kyb/strategies-11","page_id":"/docs/ui/kyb/strategies","type":"heading"