s/ui/kyb/risk-assessment-1","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#what-is-kyb-compliance","content":"What is KYB compliance?"},"679":{"id":"/docs/ui/kyb/risk-assessment-2","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#what-does-ambriels-kyb-risk-assessment-solution-do","content":"What does Ambriel's KYB Risk Assessment solution do?"},"680":{"id":"/docs/ui/kyb/risk-assessment-3","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#screening","content":"Screening"},"681":{"id":"/docs/ui/kyb/risk-assessment-4","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#monitoring","content":"Monitoring"},"682":{"id":"/docs/ui/kyb/risk-assessment-5","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#data-management","content":"Data Management"},"683":{"id":"/docs/ui/kyb/risk-assessment-6","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#how-does-a-kyb-risk-assessment-work-in-practice","content":"How does a KYB risk assessment work in practice?"},"684":{"id":"/docs/ui/kyb/risk-assessment-7","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#verify-the-company-exists","content":"Verify the company exists"},"685":{"id":"/docs/ui/kyb/risk-assessment-8","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#map-ownership-and-control","content":"Map ownership and control"},"686":{"id":"/docs/ui/kyb/risk-assessment-9","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#screen-the-entity-and-its-people","content":"Screen the entity and its people"},"687":{"id":"/docs/ui/kyb/risk-assessment-10","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#score-decide-and-monitor","content":"Score, decide, and monitor"},"688":{"id":"/docs/ui/kyb/risk-assessment-11","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"How do the signals combine into a score?"},"689":{"id":"/docs/ui/kyb/risk-assessment-12","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#how-does-it-work-technically","content":"How does it work technically?"},"690":{"id":"/docs/ui/kyb/risk-assessment-13","page_id":"/docs/ui/kyb/risk-assessment","type":"heading","url":"/docs/ui/kyb/risk-assessment#frequently-asked-questions","content":"Frequently asked questions"},"691":{"id":"/docs/ui/kyb/risk-assessment-14","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#what-is-kyb-compliance","content":"The Financial Action Task Force (FATF) recommends that countries implement effective Anti-Money Laundering (AML) and Combating the Financing of Terrorism (CFT) regulations. The European Union's 5th and 6th Anti-Money Laundering Directives (AMLD5/6) also require businesses to verify the identity of corporate entities, assess their risk profiles, and screen against global sanction lists, PEP (Politically Exposed Persons) databases, and high-risk profiles."},"692":{"id":"/docs/ui/kyb/risk-assessment-15","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#what-is-kyb-compliance","content":"In practice, that means three duties for every business customer: prove the company exists and is who it claims to be, understand who owns and controls it, and keep watching its risk profile for as long as the relationship lasts."},"693":{"id":"/docs/ui/kyb/risk-assessment-16","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#what-does-ambriels-kyb-risk-assessment-solution-do","content":"Ambriel's KYB risk assessment solution is designed to help businesses verify business identities and assess their risk exposure. It does this by providing real-time screening, monitoring, and data management capabilities."},"694":{"id":"/docs/ui/kyb/risk-assessment-17","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#screening","content":"The KYB API screens businesses against global sanction lists, PEP databases, and high-risk profiles. This ensures that businesses are compliant with KYB regulations and can assess potential risks associated with business partners and customers."},"695":{"id":"/docs/ui/kyb/risk-assessment-18","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#monitoring","content":"The KYB API also provides continuous monitoring, alerting businesses to any changes in a business entity's compliance status or risk profile over time."},"696":{"id":"/docs/ui/kyb/risk-assessment-19","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#data-management","content":"The KYB API provides a secure and reliable way to manage business data, ensuring that it is up-to-date and accurate. Additionally, all searches and results are stored in a secure and tamper-proof log for 5 years, providing a complete audit trail."},"697":{"id":"/docs/ui/kyb/risk-assessment-20","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-does-a-kyb-risk-assessment-work-in-practice","content":"Follow a new business customer — \"Nordvik Trading OÜ\", a supposedly Estonian wholesaler applying for a merchant account — through a full assessment. Each step adds signals, and the signals combine into a score your policy can act on."},"698":{"id":"/docs/ui/kyb/risk-assessment-21","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#verify-the-company-exists","content":"Pull the registration record: legal name, number, status, incorporation date, registered address, and declared activity. Nordvik exists in the registry — but it was incorporated 4 months ago and its declared wholesale activity has no website, no premises photos, and no trade history."},"699":{"id":"/docs/ui/kyb/risk-assessment-22","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#map-ownership-and-control","content":"Resolve directors, shareholders, and ultimate beneficial owners (UBOs), then screen each person against sanctions, PEP, and crime lists. Nordvik's sole director is a 21-year-old nominee appearing as director of 14 other recently formed companies — a classic shell-company pattern."},"700":{"id":"/docs/ui/kyb/risk-assessment-23","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#screen-the-entity-and-its-people","content":"Run the company and every UBO against sanctions, PEP, crime, and adverse-media lists. The company itself is not listed, but one UBO's name scores 0.82 against a crime-list profile with a matching nationality and birth year — a possible match needing enhanced review."},"701":{"id":"/docs/ui/kyb/risk-assessment-24","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#score-decide-and-monitor","content":"Combine existence, ownership, and screening signals into a risk score, apply your policy (approve, approve with limits, or decline), and keep the entity monitored so new listings or status changes raise alerts automatically."},"702":{"id":"/docs/ui/kyb/risk-assessment-25","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"The table below shows how Nordvik's signals translate into a worked risk score. Weights are illustrative — calibrate them to your own risk appetite."},"703":{"id":"/docs/ui/kyb/risk-assessment-26","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"Signal"},"704":{"id":"/docs/ui/kyb/risk-assessment-27","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"Finding for Nordvik"},"705":{"id":"/docs/ui/kyb/risk-assessment-28","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"Points (0–25 each)"},"706":{"id":"/docs/ui/kyb/risk-assessment-29","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"Company existence and age"},"707":{"id":"/docs/ui/kyb/risk-assessment-30","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"Registered but only 4 months old, no verifiable premises"},"708":{"id":"/docs/ui/kyb/risk-assessment-31","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"18"},"709":{"id":"/docs/ui/kyb/risk-assessment-32","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"Ownership transparency"},"710":{"id":"/docs/ui/kyb/risk-assessment-33","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"Nominee director shared across 14 companies, UBO unclear"},"711":{"id":"/docs/ui/kyb/risk-assessment-34","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"22"},"712":{"id":"/docs/ui/kyb/risk-assessment-35","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"Sanctions and crime screening"},"713":{"id":"/docs/ui/kyb/risk-assessment-36","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"Possible (0.82) crime-list match on a UBO"},"714":{"id":"/docs/ui/kyb/risk-assessment-37","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"16"},"715":{"id":"/docs/ui/kyb/risk-assessment-38","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"Adverse media and activity"},"716":{"id":"/docs/ui/kyb/risk-assessment-39","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"No website, no trade history, no digital footprint"},"717":{"id":"/docs/ui/kyb/risk-assessment-40","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"14"},"718":{"id":"/docs/ui/kyb/risk-assessment-41","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"Total risk score"},"719":{"id":"/docs/ui/kyb/risk-assessment-42","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"70 / 100 — high risk"},"720":{"id":"/docs/ui/kyb/risk-assessment-43","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"70"},"721":{"id":"/docs/ui/kyb/risk-assessment-44","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"At 70/100, a typical policy routes Nordvik to enhanced due diligence: request certified ownership documents, verify source of funds, and get senior sign-off — or decline the merchant account if documents do not arrive. A long-established manufacturer with transparent owners and zero list hits would instead score under 20 and pass straight through."},"722":{"id":"/docs/ui/kyb/risk-assessment-45","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"type: warning"},"723":{"id":"/docs/ui/kyb/risk-assessment-46","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"title: A clean registry record is not a clean bill of health"},"724":{"id":"/docs/ui/kyb/risk-assessment-47","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-do-the-signals-combine-into-a-score","content":"Shell companies are usually properly registered — that is the point. Registration proves existence, not legitimacy. Ownership opacity, nominee patterns, and missing economic substance are what separate a real business from a front."},"725":{"id":"/docs/ui/kyb/risk-assessment-48","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#how-does-it-work-technically","content":"The KYB API integrates seamlessly with the Fraud API, providing a holistic approach to business risk assessment and financial crime prevention. Score the onboarding transaction for fraud signals while KYB verifies the business behind it, and hold funds or limit activity when either side fires. The KYB API is designed to be compatible with the Anti-Money Laundering Directive (AMLD5/6) of the European Union, as well as the recommendations of the Financial Action Task Force (FATF)."},"726":{"id":"/docs/ui/kyb/risk-assessment-49","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#frequently-asked-questions","content":"At minimum: certified certificate of incorporation, memorandum and articles, a current shareholder register, photo ID for every UBO above your threshold (commonly 25%), and proof of address for the operating premises. Escalate anything inconsistent to a compliance officer before onboarding."},"727":{"id":"/docs/ui/kyb/risk-assessment-50","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#frequently-asked-questions","content":"Treat 0.6–0.9 scores as enhanced-review territory: collect extra identifiers, compare nationality, birth year, and addresses, and set a review date. Only freeze or exit when the match firms up or your policy's sanctions rule triggers — but never ignore it."},"728":{"id":"/docs/ui/kyb/risk-assessment-51","page_id":"/docs/ui/kyb/risk-assessment","type":"text","url":"/docs/ui/kyb/risk-assessment#frequently-asked-questions","content":"All searches, scores, documents, and decisions live in the tamper-proof log for 5 years, so a regulator can replay exactly what you knew and when you knew it."},"729":{"id":"/docs/ui/kyb/strategies","page_id":"/docs/ui/kyb/strategies","type":"page","content":"KYB Risk Scoring Strategies","url":"/docs/ui/kyb/strategies"},"730":{"id":"/docs/ui/kyb/strategies-0","page_id":"/docs/ui/kyb/strategies","type":"text","url":"/docs/ui/kyb/strategies","content":"Learn how Ambriel scores company risk: business-signal rules, weighted strategies and KYB assessments tuned to your own policy."},"731":{"id":"/docs/ui/kyb/strategies-1","page_id":"/docs/ui/kyb/strategies","type":"heading","url":"/docs/ui/kyb/strategies#kyb-risk-scoring-strategies","content":"KYB Risk Scoring Strategies"},"732":{"id":"/docs/ui/kyb/strategies-2","page_id":"/docs/ui/kyb/strategies","type":"heading","url":"/docs/ui/kyb/strategies#how-rules-work","content":"How Rules Work"},"733":{"id":"/docs/ui/kyb/strategies-3","page_id":"/docs/ui/kyb/strategies","type":"heading","url":"/docs/ui/kyb/strategies#risk-matrix-reference","content":"Risk Matrix Reference"},