at-does-the-api-return","content":"Review lookalike or suspicious-TLD domains for phishing patterns"},"1231":{"id":"/docs/ui/products/email-address-analytics-38","page_id":"/docs/ui/products/email-address-analytics","type":"text","url":"/docs/ui/products/email-address-analytics#what-does-the-api-return","content":"stringAnalysis counts and ratios"},"1232":{"id":"/docs/ui/products/email-address-analytics-39","page_id":"/docs/ui/products/email-address-analytics","type":"text","url":"/docs/ui/products/email-address-analytics#what-does-the-api-return","content":"Digits, dots, plus signs, vowel/consonant balance"},"1233":{"id":"/docs/ui/products/email-address-analytics-40","page_id":"/docs/ui/products/email-address-analytics","type":"text","url":"/docs/ui/products/email-address-analytics#what-does-the-api-return","content":"Flag random-string addresses (jx8q2z@…) typical of mass-created accounts"},"1234":{"id":"/docs/ui/products/email-address-analytics-41","page_id":"/docs/ui/products/email-address-analytics","type":"text","url":"/docs/ui/products/email-address-analytics#what-does-the-api-return","content":"breaches.numberOfBreaches / breaches.list"},"1235":{"id":"/docs/ui/products/email-address-analytics-42","page_id":"/docs/ui/products/email-address-analytics","type":"text","url":"/docs/ui/products/email-address-analytics#what-does-the-api-return","content":"Known breach appearances for the address"},"1236":{"id":"/docs/ui/products/email-address-analytics-43","page_id":"/docs/ui/products/email-address-analytics","type":"text","url":"/docs/ui/products/email-address-analytics#what-does-the-api-return","content":"Step up authentication when a new address already appears in leaks"},"1237":{"id":"/docs/ui/products/email-address-analytics-44","page_id":"/docs/ui/products/email-address-analytics","type":"text","url":"/docs/ui/products/email-address-analytics#try-it-example-request","content":"type: info"},"1238":{"id":"/docs/ui/products/email-address-analytics-45","page_id":"